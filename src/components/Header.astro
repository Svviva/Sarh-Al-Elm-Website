---
import { getEntry } from 'astro:content';interface Props{lang:'en'|'ar'}const{lang}=Astro.props;const isAr=lang==='ar';let silaUrl='';try{const settings=await getEntry('settings','site');const configured=settings?.data.silaLoginUrl||'';silaUrl=configured&&!configured.includes('example.com')?configured:''}catch{}const nav=isAr?[{href:'/ar/',label:'الرئيسية'},{href:'/ar/about/',label:'عن المدرسة'},{href:'/ar/academics/',label:'التعليم'},{href:'/ar/school-life/',label:'الحياة المدرسية'},{href:'/ar/admissions/',label:'القبول'},{href:'/ar/news/',label:'الأخبار'},{href:'/ar/contact/',label:'اتصل بنا'}]:[{href:'/',label:'Home'},{href:'/about/',label:'About'},{href:'/academics/',label:'Academics'},{href:'/school-life/',label:'School Life'},{href:'/admissions/',label:'Admissions'},{href:'/news/',label:'News'},{href:'/contact/',label:'Contact'}];const currentPath=Astro.url.pathname;const toggleHref=isAr?currentPath.replace(/^\/ar/,'')||'/':`/ar${currentPath}`;
---
<header class="site-header"><div class="wrap header-inner"><a class="brand" href={isAr?'/ar/':'/'}><img class="crest" src="/images/branding/school-crest.jpeg" alt={isAr?'شعار مدرسة صرح العلم الخاصة':'Sarh Al Elm Private School crest'} width="52" height="52"/><span class="brand-text"><span class="name">{isAr?'صرح العلم':'Sarh Al Elm'}</span><span class="tag">{isAr?'مدرسة خاصة · مسقط':'Private School · Muscat'}</span></span></a><nav aria-label={isAr?'التنقل الرئيسي':'Main navigation'}><button class="nav-toggle" aria-expanded="false" aria-controls="nav-list" id="nav-toggle" aria-label={isAr?'فتح القائمة':'Open navigation'}><span></span><span></span><span></span></button><ul id="nav-list">{nav.map(item=><li><a href={item.href}>{item.label}</a></li>)}</ul></nav><div class="nav-right"><a class="lang-toggle" href={toggleHref} aria-label={isAr?'Switch to English':'التبديل إلى العربية'}>{isAr?'EN':'عربي'}</a>{silaUrl?<a class="login" href={silaUrl} target="_blank" rel="noopener">{isAr?'تسجيل الدخول إلى سيلا':'Sila Login'}</a>:<span class="login pending" title={isAr?'سيتم تفعيل الرابط عند جاهزية منصة سيلا':'The link will be activated when the Sila platform is ready'}>{isAr?'سيلا · قريباً':'Sila · Coming soon'}</span>}<a class="apply" href={isAr?'/ar/admissions/':'/admissions/'}>{isAr?'قدّم الآن':'Apply Now'}</a></div></div></header>
<style>.site-header{position:sticky;top:0;background:rgba(255,255,255,.98);border-bottom:1px solid #e8edf2;z-index:50;backdrop-filter:blur(12px);transition:box-shadow .28s ease,background .28s ease}.site-header.scrolled{box-shadow:0 7px 24px rgba(14,42,70,.1);background:rgba(255,255,255,.95)}.header-inner{min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:20px;transition:min-height .28s ease}.site-header.scrolled .header-inner{min-height:66px}.brand{display:flex;align-items:center;gap:12px;text-decoration:none;flex-shrink:0}.crest{width:50px;height:50px;border-radius:50%;object-fit:cover;transition:width .28s ease,height .28s ease,opacity .28s ease}.site-header.scrolled .crest{width:42px;height:42px}.brand-text{display:flex;flex-direction:column;line-height:1.2}.name{font-family:var(--font-display);font-size:18px;font-weight:600;color:var(--navy-dark)}.tag{font-size:10.5px;color:var(--slate);margin-top:3px}nav ul{display:flex;align-items:center;gap:17px;list-style:none}nav a{font-size:13px;font-weight:600;text-decoration:none;color:var(--ink);white-space:nowrap;position:relative}nav ul a:after{content:"";position:absolute;left:50%;right:50%;bottom:-7px;height:2px;background:var(--gold);transition:left .22s ease,right .22s ease}nav ul a:hover:after,nav ul a:focus-visible:after{left:0;right:0}.nav-right{display:flex;align-items:center;gap:8px;flex-shrink:0}.lang-toggle,.login{font-size:12px;text-decoration:none;padding:8px}.lang-toggle{font-weight:700;color:var(--slate)}.login{display:inline-flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--navy),#176a91);color:#fff;font-weight:800;padding:9px 13px;border-radius:7px;border:1px solid rgba(255,255,255,.16);box-shadow:0 5px 14px rgba(4,34,62,.18);white-space:nowrap;transition:transform .2s ease,box-shadow .2s ease,filter .2s ease}.login:hover{transform:translateY(-1px);box-shadow:0 7px 18px rgba(4,34,62,.24);filter:brightness(1.06)}.login:focus-visible{outline:3px solid rgba(213,164,63,.42);outline-offset:2px}.pending{opacity:.7;cursor:default;white-space:nowrap;background:#eef3f7;color:var(--slate);box-shadow:none;border-color:#dbe3ea}.apply{background:var(--navy);color:#fff;text-decoration:none;font-size:13px;font-weight:700;padding:10px 15px;border-radius:7px}.nav-toggle{display:none;background:none;border:0;padding:10px}.nav-toggle span{display:block;width:24px;height:2px;background:var(--ink);margin:5px 0}@media(max-width:1120px){nav ul{gap:12px}.brand-text .tag,.login{display:none}}@media(max-width:930px){.header-inner,.site-header.scrolled .header-inner{min-height:70px}.nav-toggle{display:block}nav{order:3}nav ul{display:flex;visibility:hidden;opacity:0;pointer-events:none;position:absolute;top:70px;left:auto;right:0;width:min(360px,92vw);height:calc(100vh - 70px);background:#fff;padding:18px 22px 24px;box-shadow:-15px 18px 30px rgba(14,42,70,.14);flex-direction:column;align-items:stretch;gap:0;transform:translateX(105%);transition:transform .3s cubic-bezier(.2,.7,.25,1),opacity .25s ease,visibility .3s}html[dir="rtl"] nav ul{right:auto;left:0;transform:translateX(-105%);box-shadow:15px 18px 30px rgba(14,42,70,.14)}nav ul.open,html[dir="rtl"] nav ul.open{visibility:visible;opacity:1;pointer-events:auto;transform:translateX(0)}nav a{display:block;padding:13px 6px;border-bottom:1px solid #eef1f4}.brand-text .name{font-size:16px}.crest{width:44px;height:44px}.lang-toggle{display:inline-flex;align-items:center;justify-content:center;min-width:46px;height:38px;padding:7px 10px;border:1px solid #dbe3ea;border-radius:7px;background:#fff;color:var(--navy-dark)}}@media(max-width:480px){.header-inner{padding-left:14px;padding-right:14px;gap:6px}.nav-right{gap:5px}.lang-toggle{min-width:42px;height:36px;padding:6px 8px;font-size:11px}.apply{padding:9px 9px;font-size:11px}.brand{gap:7px}.brand-text .name{font-size:13px}.crest{width:40px;height:40px}.nav-toggle{padding:8px}.nav-toggle span{width:22px}}</style><script>const header=document.querySelector(".site-header");const onScroll=()=>header?.classList.toggle("scrolled",window.scrollY>24);onScroll();window.addEventListener("scroll",onScroll,{passive:true});const toggle=document.getElementById('nav-toggle'),list=document.getElementById('nav-list');toggle?.addEventListener('click',()=>{const open=list?.classList.toggle('open');toggle.setAttribute('aria-expanded',String(!!open))});</script>