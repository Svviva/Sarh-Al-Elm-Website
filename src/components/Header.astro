---
import { getEntry } from 'astro:content';
interface Props { lang: 'en' | 'ar'; }
const { lang } = Astro.props;
const isAr = lang === 'ar';
let silaUrl = '#';
try { const settings = await getEntry('settings', 'site'); silaUrl = settings?.data.silaLoginUrl || '#'; } catch {}
const nav = isAr ? [
{ href:'/ar/',label:'الرئيسية'},{href:'/ar/about/',label:'عن المدرسة'},{href:'/ar/academics/',label:'الأكاديميات'},{href:'/ar/admissions/',label:'القبول'},{href:'/ar/news/',label:'الأخبار'},{href:'/ar/gallery/',label:'معرض الصور'},{href:'/ar/contact/',label:'اتصل بنا'}
] : [
{href:'/',label:'Home'},{href:'/about/',label:'About'},{href:'/academics/',label:'Academics'},{href:'/admissions/',label:'Admissions'},{href:'/news/',label:'News'},{href:'/gallery/',label:'Gallery'},{href:'/contact/',label:'Contact'}
];
const currentPath = Astro.url.pathname;
const toggleHref = isAr ? currentPath.replace(/^\/ar/, '') || '/' : `/ar${currentPath}`;
---
<header class="site-header">
<div class="wrap header-inner">
<a class="brand" href={isAr?'/ar/':'/'}><img class="crest" src="/images/branding/school-crest.jpeg" alt="Sarh Al Elm Private School crest" width="52" height="52"/><span class="brand-text"><span class="name">{isAr?'صرح العلم':'Sarh Al Elm'}</span><span class="tag">{isAr?'نطمح للنجاح':'Private School · Muscat'}</span></span></a>
<nav aria-label="Main navigation"><button class="nav-toggle" aria-expanded="false" aria-controls="nav-list" id="nav-toggle" aria-label="Open navigation"><span></span><span></span><span></span></button><ul id="nav-list">{nav.map(item=><li><a href={item.href}>{item.label}</a></li>)}</ul></nav>
<div class="nav-right"><a class="lang-toggle" href={toggleHref}>{isAr?'EN':'عربي'}</a><a class="login" href={silaUrl} target="_blank" rel="noopener">{isAr?'دخول سيلا':'Sila Login'}</a><a class="apply" href={isAr?'/ar/admissions/':'/admissions/'}>{isAr?'التقديم':'Apply Now'}</a></div>
</div>
</header>
<style>
.site-header{position:sticky;top:0;background:rgba(255,255,255,.98);border-bottom:1px solid #e8edf2;z-index:50;backdrop-filter:blur(12px)}.header-inner{min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:flex;align-items:center;gap:12px;text-decoration:none;flex-shrink:0}.crest{width:50px;height:50px;border-radius:50%;object-fit:cover}.brand-text{display:flex;flex-direction:column;line-height:1.2}.name{font-family:var(--font-display);font-size:18px;font-weight:600;color:var(--navy-dark)}.tag{font-size:10.5px;color:var(--slate);margin-top:3px}nav ul{display:flex;align-items:center;gap:22px;list-style:none}nav a{font-size:13.5px;font-weight:600;text-decoration:none;color:var(--ink)}nav a:hover{color:var(--navy)}.nav-right{display:flex;align-items:center;gap:9px;flex-shrink:0}.lang-toggle,.login{font-size:12.5px;text-decoration:none;color:var(--slate);padding:8px 10px}.apply{background:var(--navy);color:#fff;text-decoration:none;font-size:13px;font-weight:700;padding:10px 16px;border-radius:7px}.nav-toggle{display:none;background:none;border:0;padding:10px;cursor:pointer}.nav-toggle span{display:block;width:24px;height:2px;background:var(--ink);margin:5px 0}
@media(max-width:1080px){nav ul{gap:14px}.brand-text .tag{display:none}.login{display:none}}
@media(max-width:900px){.header-inner{min-height:70px}.nav-toggle{display:block}nav{order:3}nav ul{display:none;position:absolute;top:70px;left:0;right:0;background:#fff;padding:12px 18px 20px;box-shadow:0 15px 30px rgba(14,42,70,.12);flex-direction:column;align-items:stretch;gap:0}nav ul.open{display:flex}nav a{display:block;padding:13px 6px;border-bottom:1px solid #eef1f4}.brand-text .name{font-size:16px}.crest{width:44px;height:44px}.lang-toggle{display:none}}
@media(max-width:480px){.header-inner{padding-left:14px;padding-right:14px;gap:8px}.apply{padding:9px 11px;font-size:12px}.brand{gap:8px}.brand-text .name{font-size:14px}}
</style>
<script>const toggle=document.getElementById('nav-toggle');const list=document.getElementById('nav-list');toggle?.addEventListener('click',()=>{const open=list?.classList.toggle('open');toggle.setAttribute('aria-expanded',String(!!open));});</script>