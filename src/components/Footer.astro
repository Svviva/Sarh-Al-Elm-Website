---
import { getEntry } from 'astro:content';

interface Props {
  lang: 'en' | 'ar';
}
const { lang } = Astro.props;
const isAr = lang === 'ar';
const p = isAr ? '/ar' : '';

let settings;
try {
  settings = await getEntry('settings', 'site');
} catch {}
const data = settings?.data;

const socials = [
  { url: data?.facebookUrl, label: 'Facebook', icon: 'facebook' },
  { url: data?.instagramUrl, label: 'Instagram', icon: 'instagram' },
  { url: data?.youtubeUrl, label: 'YouTube', icon: 'youtube' },
  { url: data?.twitterUrl, label: 'Twitter / X', icon: 'twitter' },
].filter((s) => s.url);

const whatsappDigits = data?.whatsappNumber?.replace(/[^0-9]/g, '');
const whatsappUrl = whatsappDigits ? `https://wa.me/${whatsappDigits}` : null;

const ICONS: Record<string, string> = {
  facebook: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.08 5.66 21.24 10.44 22v-7.03H7.9v-2.91h2.54V9.86c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.44 2.91h-2.34V22C18.34 21.24 22 17.08 22 12.06Z"/></svg>',
  instagram: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>',
  youtube: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.4-.43-5a2.9 2.9 0 0 0-2-2C18.9 4.5 12 4.5 12 4.5s-6.9 0-8.57.5a2.9 2.9 0 0 0-2 2C1 8.6 1 12 1 12s0 3.4.43 5a2.9 2.9 0 0 0 2 2c1.67.5 8.57.5 8.57.5s6.9 0 8.57-.5a2.9 2.9 0 0 0 2-2C23 15.4 23 12 23 12ZM9.75 15.5v-7l6 3.5-6 3.5Z"/></svg>',
  twitter: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.2 8.2L23.3 22h-6.6l-5.2-6.8L5.5 22H2.4l7.7-8.8L1 2h6.8l4.7 6.3L18.9 2Zm-1.2 18h1.8L7.4 3.9H5.5L17.7 20Z"/></svg>',
  whatsapp: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.1-1.3A10 10 0 1 0 12 2Zm5.8 14.2c-.2.7-1.4 1.4-2 1.5-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5-4.5-.1-.2-1.2-1.6-1.2-3s.7-2.2 1-2.5c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5.2.5.7 1.8.8 1.9.1.2.1.3 0 .5-.1.2-.2.3-.3.5-.2.2-.3.3-.5.5-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2.3 1.3 1.2 2.4 1.5 2.7 1.7.3.2.5.1.7-.1.2-.2.8-.9 1-1.2.2-.3.4-.2.7-.1.3.1 1.7.8 2 1 .3.1.5.2.6.3.1.2.1.7-.1 1.4Z"/></svg>',
};

// Real accreditation/affiliation logos
const badges = [
  { src: '/images/branding/moe-logo.jpeg', alt: isAr ? 'وزارة التربية والتعليم' : 'Ministry of Education' },
  { src: '/images/branding/oman-vision-2040-logo.jpeg', alt: isAr ? 'رؤية عمان 2040' : 'Oman Vision 2040' },
];
---
<footer>
  <div class="wrap footer-grid">
    <div>
      <div class="brand">
        <img class="crest" src="/images/branding/school-crest.jpeg" alt="Sarh Al Elm Private School crest" />
        <span class="name">{isAr ? 'صرح العلم' : 'Sarh Al Elm'}</span>
      </div>
      <p class="blurb">
        {isAr
          ? 'مدرسة خاصة معتمدة من كامبريدج ووزارة التربية والتعليم العمانية، تخدم الصفوف ١ إلى ٨ في مسقط.'
          : 'A Cambridge and Oman MOE-aligned private school serving Grades 1–8 in Muscat.'}
      </p>
      {socials.length > 0 && (
        <ul class="socials">
          {socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" aria-label={s.label} set:html={ICONS[s.icon]} />
            </li>
          ))}
        </ul>
      )}
    </div>
    <div>
      <h4>{isAr ? 'استكشف' : 'Explore'}</h4>
      <ul>
        <li><a href={`${p}/about/`}>{isAr ? 'عن المدرسة' : 'About'}</a></li>
        <li><a href={`${p}/academics/`}>{isAr ? 'الأكاديميات' : 'Academics'}</a></li>
        <li><a href={`${p}/admissions/`}>{isAr ? 'القبول' : 'Admissions'}</a></li>
      </ul>
    </div>
    <div>
      <h4>{isAr ? 'المجتمع' : 'Community'}</h4>
      <ul>
        <li><a href={`${p}/news/`}>{isAr ? 'الأخبار' : 'News'}</a></li>
        <li><a href={`${p}/gallery/`}>{isAr ? 'معرض الصور' : 'Gallery'}</a></li>
        {data?.silaLoginUrl && <li><a href={data.silaLoginUrl} target="_blank" rel="noopener">Sila Login</a></li>}
      </ul>
    </div>
    <div>
      <h4>{isAr ? 'اتصل بنا' : 'Contact'}</h4>
      <ul>
        {data?.address && <li>{isAr ? (data.address_ar || data.address) : data.address}</li>}
        {data?.phone && (
          <li class="phone-row">
            <a href={`tel:${data.phone.replace(/[^0-9+]/g, '')}`}>{data.phone}</a>
            {whatsappUrl && (
              <a href={whatsappUrl} target="_blank" rel="noopener" class="whatsapp-link" aria-label="Chat on WhatsApp" set:html={ICONS.whatsapp} />
            )}
          </li>
        )}
        {data?.email && <li><a href={`mailto:${data.email}`}>{data.email}</a></li>}
      </ul>
    </div>
  </div>
  <div class="wrap badges">
    {badges.map((b) => (
      <span class="badge">
        <img src={b.src} alt={b.alt} />
      </span>
    ))}
  </div>
  <div class="wrap footer-bottom">
    <span>© {new Date().getFullYear()} {isAr ? 'صرح العلم للتعليم الخاص' : 'Sarh Al Elm Private School'}</span>
    <a href={`${p}/privacy/`}>{isAr ? 'سياسة الخصوصية' : 'Privacy Policy · PDPL Compliance'}</a>
  </div>
</footer>

<style>
  footer { background: var(--navy-dark); color: #CFE0F2; padding: 56px 0 28px; margin-top: 0; }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 32px;
    margin-bottom: 40px;
  }
  .brand { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .crest {
    width: 40px; height: 40px; border-radius: 50%; object-fit: cover; flex-shrink: 0;
  }
  .brand .name { font-family: var(--font-display); color: #fff; font-size: 16px; font-weight: 600; }
  .blurb { font-size: 13px; color: #9FB6D0; max-width: 280px; line-height: 1.6; }
  .socials { list-style: none; display: flex; gap: 10px; margin-top: 16px; }
  .socials a {
    color: #CFE0F2; display: flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 50%; background: rgba(255,255,255,.08);
    transition: background .2s ease, transform .2s ease;
  }
  .socials a:hover { background: rgba(255,255,255,.18); transform:translateY(-3px) scale(1.05); }
  .socials a :global(svg) { width: 17px; height: 17px; }
  h4 { color: #fff; font-size: 14px; margin-bottom: 14px; font-weight: 600; }
  footer ul { list-style: none; font-size: 13.5px; line-height: 2.1; }
  .phone-row { display: flex; align-items: center; gap: 8px; }
  .whatsapp-link {
    display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px; border-radius: 50%; background: #25D366; color: #fff; flex-shrink: 0;
  }
  .whatsapp-link :global(svg) { width: 13px; height: 13px; }
  footer ul a { color: #B7CBE0; text-decoration: none; transition:color .2s ease,transform .2s ease; display:inline-block; } footer ul a:hover{color:#fff;transform:translateX(3px)} html[dir='rtl'] footer ul a:hover{transform:translateX(-3px)}
  .badges {
    display: flex; gap: 14px; flex-wrap: wrap; align-items: center;
    padding-bottom: 24px; border-bottom: 1px solid rgba(255,255,255,.12); margin-bottom: 20px;
  }
  .badge {
    background: #fff; border-radius: 8px;
    padding: 8px 14px; display: flex; align-items: center;
  }
  .badge img { height: 34px; width: auto; display: block; transition:transform .25s ease; }.badge:hover img{transform:scale(1.045)}
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,.12);
    padding-top: 20px;
    font-size: 12.5px;
    color: #8FA9C4;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }
  .footer-bottom a { color: #8FA9C4; }

  @media (max-width: 800px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
  @media(prefers-reduced-motion:reduce){.socials a,footer ul a,.badge img{transition:none!important;transform:none!important}}\n</style>
