---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
let singles=[];let albums=[];try{singles=await getCollection('gallery-singles');albums=await getCollection('gallery-albums')}catch{}
const items=[...albums.map(a=>({type:'album',title:a.data.title,date:a.data.date,cover:a.data.coverImage,images:a.data.images,count:a.data.images.length})),...singles.map(s=>({type:'single',title:s.data.caption||'School life at Sarh Al Elm',date:s.data.date,cover:s.data.image,images:[s.data.image],count:1}))].sort((a,b)=>(b.date?.valueOf()||0)-(a.date?.valueOf()||0));
---
<BaseLayout title="School Gallery | Sarh Al Elm Private School" lang="en" description="Explore photographs of learning, activities and school life at Sarh Al Elm Private School in Muscat."><section class="page-hero"><div class="wrap"><p>School Gallery</p><h1>Moments from life at Sarh Al Elm</h1><span>Learning is shaped by classroom discovery, friendships, activities and shared experiences.</span></div></section><section class="block wrap"><div class="gallery">{items.length===0&&<div class="empty"><h2>Our gallery is being prepared</h2><p>School photographs and albums will appear here as they are published.</p></div>}{items.map((item,i)=><button class={`tile tile-${i%7}`} data-index={i} type="button" aria-label={`View ${item.title}`}><img src={item.cover} alt={item.title} loading={i<4?'eager':'lazy'} decoding="async"/><span class="shade"></span><span class="meta"><strong>{item.title}</strong>{item.type==='album'&&<small>{item.count} photos</small>}</span></button>)}</div></section><dialog id="gallery-dialog"><button id="close-dialog" class="close" aria-label="Close gallery">×</button><div id="dialog-content" class="dialog-content"></div></dialog></BaseLayout>
<script define:vars={{items}}>const d=document.getElementById('gallery-dialog');const c=document.getElementById('dialog-content');document.querySelectorAll('.tile').forEach(t=>t.addEventListener('click',()=>{const item=items[Number(t.getAttribute('data-index'))];c.innerHTML=`<header><h2>${item.title}</h2></header><div class="dialog-images">${item.images.map((src,j)=>`<img src="${src}" alt="${item.title} ${j+1}" loading="lazy">`).join('')}</div>`;d?.showModal()}));document.getElementById('close-dialog')?.addEventListener('click',()=>d?.close());d?.addEventListener('click',e=>{if(e.target===d)d.close()});</script>
<style>
.page-hero{background:linear-gradient(120deg,#063e73,#07589e);color:#fff;padding:76px 0}.page-hero p{font-size:12px;text-transform:uppercase;letter-spacing:.1em;color:#d5a43f;font-weight:700}.page-hero h1{font-family:var(--font-display);font-size:clamp(35px,5vw,52px);margin:8px 0 12px}.page-hero span{color:#dce7f4}.block{padding-top:70px;padding-bottom:80px}.gallery{columns:3 260px;column-gap:16px}.tile{position:relative;width:100%;display:block;margin:0 0 16px;border:0;border-radius:12px;overflow:hidden;background:#e8edf2;cursor:pointer;break-inside:avoid}.tile img{width:100%;height:auto;min-height:220px;object-fit:cover;transition:transform .35s}.tile:nth-child(5n+1) img{aspect-ratio:4/5}.tile:nth-child(5n+2) img{aspect-ratio:4/3}.tile:nth-child(5n+3) img{aspect-ratio:1/1}.tile:hover img{transform:scale(1.025)}.shade{position:absolute;inset:35% 0 0;background:linear-gradient(transparent,rgba(3,19,34,.82))}.meta{position:absolute;left:18px;right:18px;bottom:15px;color:#fff;text-align:left}.meta strong{display:block;font-size:14px}.meta small{display:block;margin-top:3px;color:#dce7f4}.empty{background:var(--cream);padding:45px;border-radius:12px;text-align:center}.empty h2{font-family:var(--font-display);color:var(--navy-dark)}dialog{width:min(960px,94vw);max-height:90vh;margin:auto;border:0;border-radius:12px;background:#071a2b;color:#fff;padding:24px}dialog::backdrop{background:rgba(2,13,24,.88)}.close{position:sticky;top:0;float:right;z-index:2;border:0;background:#fff;color:#111;border-radius:50%;width:38px;height:38px;font-size:26px;cursor:pointer}.dialog-content h2{font-family:var(--font-display);padding:8px 50px 22px 4px}.dialog-images{display:grid;gap:14px}.dialog-images :global(img){width:100%;border-radius:8px}@media(max-width:600px){.page-hero{padding:58px 0}.block{padding-top:45px;padding-bottom:55px}.gallery{columns:2 140px;column-gap:10px}.tile{margin-bottom:10px}.tile img{min-height:150px}.meta{left:11px;right:11px;bottom:10px}.meta strong{font-size:12px}dialog{padding:14px}}
</style>