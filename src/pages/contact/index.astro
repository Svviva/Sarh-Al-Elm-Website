---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
let settings; try { settings=await getEntry('settings','site'); } catch {}
const data=settings?.data; const phone=data?.phone||'+96897817830'; const email=data?.email||'sarhalilm-mawalih@moe.om'; const wa=data?.whatsappNumber||'96897817830';
---
<BaseLayout title="Contact | Sarh Al Elm Private School, Muscat" lang="en" description="Contact Sarh Al Elm Private School in Muscat, Oman by phone, email or WhatsApp.">
<section class="page-hero"><div class="wrap"><p class="eyebrow">Contact Sarh Al Elm</p><h1>How can we help?</h1><p>Whether you are enquiring about admissions, academics, school life or general information, our team would be pleased to assist you.</p></div></section>
<section class="block wrap contact-grid"><div class="details"><p class="kicker">School details</p><h2>Get in touch</h2><div class="detail"><span>Location</span><strong>{data?.address||'Muscat, Oman'}</strong></div><div class="detail"><span>Phone</span><a href={`tel:${phone}`}>{phone}</a></div><div class="detail"><span>Email</span><a href={`mailto:${email}`}>{email}</a></div>{data?.instagramUrl&&<a class="social" href={data.instagramUrl} target="_blank" rel="noopener">Visit our Instagram →</a>}</div><div class="whatsapp-card"><p class="kicker">Parent enquiries</p><h2>Message the school on WhatsApp</h2><p>For admissions questions, academic enquiries, school-life questions or other concerns, parents and guardians are welcome to contact Sarh Al Elm Private School directly on WhatsApp.</p><a class="whatsapp" href={`https://wa.me/${wa}?text=${encodeURIComponent('Hello Sarh Al Elm Private School. I would like to make an enquiry about: ')}`} target="_blank" rel="noopener">Contact us on WhatsApp</a><small>A WhatsApp conversation will open with a message ready for you to complete.</small></div></section>
<section class="map-band"><div class="wrap">{data?.mapEmbedUrl?<iframe src={data.mapEmbedUrl} loading="lazy" title="Sarh Al Elm Private School location"></iframe>:<div class="map-placeholder"><strong>School location</strong><p>{data?.address||'Muscat, Oman'}</p><small>A map can be displayed here once the school's approved map embed link is added to site settings.</small></div>}</div></section>
</BaseLayout>
<style>.page-hero{background:var(--navy-dark);color:#fff;padding:78px 0}.eyebrow,.kicker{font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#d5a43f;margin-bottom:9px}.page-hero h1{font-family:var(--font-display);font-size:clamp(36px,5vw,52px);margin-bottom:12px}.page-hero p{color:#dce7f4;max-width:650px}.block{padding-top:76px;padding-bottom:76px}.contact-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px}.details h2,.whatsapp-card h2{font-family:var(--font-display);font-size:30px;color:var(--navy-dark);margin-bottom:28px}.detail{padding:17px 0;border-bottom:1px solid #e7eaee}.detail span{display:block;font-size:12px;color:var(--slate);margin-bottom:4px}.detail strong,.detail a{font-size:15px;color:var(--ink);text-decoration:none;overflow-wrap:anywhere}.social{display:inline-block;color:var(--navy);font-weight:700;text-decoration:none;margin-top:18px}.whatsapp-card{background:var(--cream);border:1px solid #e3e7eb;border-radius:14px;padding:32px}.whatsapp-card>p{color:var(--slate);line-height:1.8}.whatsapp{display:inline-block;background:#edf8f1;border:1px solid #cfe9d8;color:#176b38;text-decoration:none;font-weight:700;padding:15px 20px;border-radius:8px;margin-top:24px}.whatsapp-card small{display:block;color:var(--slate);margin-top:15px;line-height:1.6}.map-band{background:var(--cream);padding:55px 0 75px}.map-band iframe,.map-placeholder{width:100%;height:360px;border:0;border-radius:14px}.map-placeholder{background:#fff;border:1px solid #e2e7ec;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:25px}.map-placeholder strong{font-family:var(--font-display);font-size:25px;color:var(--navy-dark)}.map-placeholder p{margin:8px 0}.map-placeholder small{color:var(--slate);max-width:500px}@media(max-width:800px){.contact-grid{grid-template-columns:1fr;gap:40px}.block{padding-top:56px;padding-bottom:56px}.page-hero{padding:60px 0}.whatsapp-card{padding:24px}.map-band{padding:40px 0 55px}}</style>