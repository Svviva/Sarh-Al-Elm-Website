---
import BaseLayout from '../../../layouts/BaseLayout.astro';import{getEntry}from'astro:content';let settings;try{settings=await getEntry('settings','site')}catch{}const data=settings?.data;const email=data?.email||'sarhalilm-mawalih@moe.om',phone=data?.phone||'+96897817830',wa=data?.whatsappNumber||'96897817830';
---
<BaseLayout title="القبول | مدرسة صرح العلم الخاصة، مسقط" lang="ar" description="تواصل مع مدرسة صرح العلم الخاصة في مسقط للحصول على أحدث متطلبات القبول والرسوم وتوفر المقاعد والإرشادات للصفوف من الأول إلى الثامن."><section class="page-hero"><div class="wrap"><p>القبول · الصفوف ١–٨</p><h1>ابدأ رحلة طفلك في صرح العلم</h1><span>يسرّنا مساعدة الأسر الراغبة في انضمام أبنائها إلى مدرستنا. للحصول على أحدث متطلبات القبول والإرشادات، يرجى التواصل مباشرة مع مدرسة صرح العلم الخاصة.</span><div class="actions"><a class="btn-primary" href="#enquiry">أرسل استفساراً</a><a class="btn-ghost" href={`https://wa.me/${wa}?text=${encodeURIComponent('مرحباً، أود الحصول على معلومات عن القبول في مدرسة صرح العلم الخاصة.')}`}>تواصل مع القبول عبر واتساب</a></div></div></section><section class="block wrap grid"><div><p class="kicker">معلومات القبول</p><h2>تواصل مع المدرسة لمعرفة المتطلبات الحالية</h2><p class="lead">قد يتم تحديث متطلبات القبول والمستندات المطلوبة والرسوم وتوفر المقاعد والترتيبات الأخرى من وقت إلى آخر. لذا نرجو من أولياء الأمور التواصل مباشرة مع مدرسة صرح العلم الخاصة للحصول على أحدث معلومات وإرشادات القبول.</p><p class="lead">سيقوم فريق المدرسة بتوضيح المتطلبات الحالية التي تنطبق على طفلك والإجابة عن أي استفسارات لديكم.</p></div><aside><h2>التواصل بشأن القبول</h2><p>تواصل مباشرة مع المدرسة للحصول على معلومات القبول الحالية.</p><a href={`tel:${phone}`}>☎ {phone}</a><a href={`mailto:${email}`}>✉ {email}</a><a class="wa" href={`https://wa.me/${wa}?text=${encodeURIComponent('مرحباً، لدي استفسار عن القبول في مدرسة صرح العلم الخاصة.')}`}>راسلنا عبر واتساب</a><small>يرجى تأكيد الرسوم الحالية وتوفر المقاعد والمستندات المطلوبة وأي ترتيبات قبول مطبقة مباشرة مع المدرسة.</small></aside></section><section id="enquiry" class="form-band"><div class="wrap form-grid"><div><p class="kicker">استفسار القبول</p><h2>اسألنا عن القبول</h2><p>أكمل هذا النموذج المختصر ليتمكن فريق المدرسة من التواصل معك باستخدام بيانات الاتصال التي تقدمها.</p></div><form name="admission-enquiry-ar" method="POST" data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="admission-enquiry-ar"/><p class="hidden"><input name="bot-field"/></p><label>اسم ولي الأمر<input name="parent-name" required/></label><label>رقم الهاتف<input name="phone" type="tel" required/></label><label>البريد الإلكتروني<input name="email" type="email"/></label><label>صف الطفل الحالي / الصف المطلوب<select name="grade" required><option value="">اختر الصف</option>{Array.from({length:8},(_,i)=><option value={`Grade ${i+1}`}>الصف {i+1}</option>)}</select></label><label>رسالتك<textarea name="message" rows="5" placeholder="أخبرنا بما تود معرفته عن القبول."></textarea></label><button type="submit">إرسال استفسار القبول</button><p class="privacy">بإرسال هذا النموذج، فإنك تطلب من المدرسة التواصل معك بشأن القبول.</p></form></div></section></BaseLayout>
<style>.page-hero{background:linear-gradient(120deg,#063e73,#07589e);color:#fff;padding:82px 0}.page-hero>div>p,.kicker{color:#d5a43f;font-weight:700}.page-hero h1,h2{font-family:var(--font-display-ar)}.page-hero h1{font-size:clamp(35px,5vw,52px);margin:10px 0}.page-hero span{display:block;max-width:700px;line-height:2}.actions{display:flex;gap:12px;margin-top:26px}.block{padding-top:75px;padding-bottom:75px}.grid{display:grid;grid-template-columns:1.4fr .7fr;gap:65px}.grid h2,.form-grid h2{font-size:28px;color:var(--navy-dark);margin-bottom:25px}.lead,aside p{color:var(--slate);font-size:15px;line-height:2;margin-bottom:16px}aside{background:var(--cream);padding:28px;border-radius:14px;height:max-content}aside a{display:block;color:var(--navy);font-weight:700;text-decoration:none;margin:13px 0;overflow-wrap:anywhere}aside small{display:block;color:var(--slate);margin-top:20px}.form-band{background:var(--cream);padding:75px 0}.form-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:55px}form{background:#fff;padding:28px;border-radius:14px}label{display:block;font-weight:700;font-size:13px;margin:12px 0}input,select,textarea{width:100%;padding:12px;margin-top:6px;border:1px solid #ccd4dc;border-radius:7px;font:inherit}button{background:var(--navy);color:#fff;border:0;border-radius:7px;padding:13px 20px;font:inherit;font-weight:700}.privacy{font-size:12px;color:var(--slate);margin-top:12px}.hidden{position:absolute;right:-9999px}@media(max-width:760px){.grid,.form-grid{grid-template-columns:1fr}.actions{flex-direction:column}.block,.form-band{padding-top:55px;padding-bottom:55px}}</style>