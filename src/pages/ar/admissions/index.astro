---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

let settings;
try { settings = await getEntry('settings', 'site'); } catch {}
const email = settings?.data.email || 'info@sarhalelm.om';
const phone = settings?.data.phone || '+968 XXXX XXXX';

const steps = [
  { title: 'تواصل مع مكتب القبول', body: 'تواصل عبر الهاتف أو البريد الإلكتروني للتحقق من توفر مقعد لصف طفلك.' },
  { title: 'تقديم المستندات المطلوبة', body: 'شهادة الميلاد، نسخة من جواز السفر، سجلات المدرسة السابقة، وصور شخصية.' },
  { title: 'التقييم والمقابلة', body: 'تقييم قصير مناسب للعمر ومقابلة عائلية في المدرسة.' },
  { title: 'القبول والتسجيل', body: 'بعد القبول، أكمل أوراق التسجيل ودفع الرسوم في مكتب المدرسة.' },
];
---
<BaseLayout title="القبول — صرح العلم" lang="ar">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">القبول</p>
      <h1>انضم إلى مجتمعنا التعليمي</h1>
      <p class="sub">تتم إجراءات القبول للصفوف ١–٨ مباشرة عبر مكتب المدرسة — إليك ما يمكن توقعه.</p>
    </div>
  </section>

  <section class="block wrap">
    <h2>كيفية التقديم</h2>
    <div class="steps">
      {steps.map((s, i) => (
        <div class="step">
          <div class="step-num">{i + 1}</div>
          <div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="block wrap contact-cta">
    <h2>تواصل مع مكتب القبول</h2>
    <p>اتصل على <a href={`tel:${phone}`}>{phone}</a> أو راسلنا على <a href={`mailto:${email}`}>{email}</a> لبدء الإجراءات.</p>
  </section>
</BaseLayout>

<style>
  .page-hero { background: var(--navy); color: #fff; padding: 64px 0; }
  .page-hero .eyebrow { color: #BFD8F0; font-size: 14px; margin-bottom: 12px; }
  .page-hero h1 { font-family: var(--font-display-ar); font-size: 30px; font-weight: 600; margin-bottom: 14px; max-width: 640px; }
  .page-hero .sub { color: #DCE7F4; max-width: 560px; font-size: 15.5px; }
  .block { padding: 64px 24px; }
  h2 { font-family: var(--font-display-ar); font-size: 22px; margin-bottom: 24px; color: var(--navy-dark); }
  .steps { display: flex; flex-direction: column; gap: 24px; max-width: 640px; }
  .step { display: flex; gap: 18px; }
  .step-num {
    width: 34px; height: 34px; border-radius: 50%; background: var(--navy); color: #fff;
    display: flex; align-items: center; justify-content: center; font-weight: 600; flex-shrink: 0;
  }
  .step h3 { font-size: 16px; font-weight: 600; margin-bottom: 6px; }
  .step p { font-size: 14.5px; color: var(--slate); line-height: 1.7; }
  .contact-cta { background: var(--cream); text-align: center; }
  .contact-cta p { font-size: 15.5px; }
  .contact-cta a { color: var(--navy); font-weight: 600; text-decoration: none; }
</style>
