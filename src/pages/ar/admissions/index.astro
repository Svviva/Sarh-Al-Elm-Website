---
import BaseLayout from '../../../layouts/BaseLayout.astro';import{getEntry}from'astro:content';let settings;try{settings=await getEntry('settings','site')}catch{}const data=settings?.data;const email=data?.email||'sarhalilm-mawalih@moe.om',phone=data?.phone||'+96897817830',wa=data?.whatsappNumber||'96897817830';
---
<BaseLayout title="القبول | مدرسة صرح العلم الخاصة، مسقط" lang="ar" description="تواصل مع مدرسة صرح العلم الخاصة في مسقط للحصول على أحدث متطلبات القبول والرسوم وتوفر المقاعد والإرشادات للصفوف من الأول إلى الثامن."><section class="page-hero"><div class="wrap"><p>القبول · رياض الأطفال ١ و٢ والصفوف ١–٨</p><h1>ابدأ رحلة طفلك في صرح العلم</h1><span>يسرّنا مساعدة الأسر الراغبة في انضمام أبنائها إلى مدرستنا. للحصول على أحدث متطلبات القبول والإرشادات، يرجى التواصل مباشرة مع مدرسة صرح العلم الخاصة.</span><div class="actions"><a class="btn-primary" href={`https://wa.me/${wa}?text=${encodeURIComponent('مرحباً، أود الحصول على معلومات عن القبول في مدرسة صرح العلم الخاصة.')}`} target="_blank" rel="noopener">اسأل عبر واتساب</a></div></div></section><section class="block wrap grid"><div><p class="kicker">معلومات القبول</p><h2>تواصل مع المدرسة لمعرفة المتطلبات الحالية</h2><p class="lead">قد يتم تحديث متطلبات القبول والمستندات المطلوبة والرسوم وتوفر المقاعد والترتيبات الأخرى من وقت إلى آخر. لذا نرجو من أولياء الأمور التواصل مباشرة مع مدرسة صرح العلم الخاصة للحصول على أحدث معلومات وإرشادات القبول.</p><p class="lead">سيقوم فريق المدرسة بتوضيح المتطلبات الحالية التي تنطبق على طفلك والإجابة عن أي استفسارات لديكم.</p></div><aside><h2>التواصل بشأن القبول</h2><p>للحصول على معلومات القبول الحالية، تواصل مباشرة مع المدرسة عبر واتساب.</p><a href={`tel:${phone}`}>☎ {phone}</a><a href={`mailto:${email}`}>✉ {email}</a><a class="wa" href={`https://wa.me/${wa}?text=${encodeURIComponent('مرحباً، لدي استفسار عن القبول في مدرسة صرح العلم الخاصة بشأن: ')}`} target="_blank" rel="noopener">راسل قسم القبول عبر واتساب</a><small>يرجى تأكيد الرسوم الحالية وتوفر المقاعد والمستندات المطلوبة وأي ترتيبات قبول مطبقة مباشرة مع المدرسة.</small></aside></section><section class="wa-band"><div class="wrap wa-box"><div><p class="kicker">استفسارات القبول</p><h2>هل لديك سؤال عن الانضمام إلى صرح العلم؟</h2><p>يمكن لأولياء الأمور إرسال استفساراتهم عن القبول مباشرة إلى المدرسة عبر واتساب.</p></div><a class="wa-large" href={`https://wa.me/${wa}?text=${encodeURIComponent('مرحباً مدرسة صرح العلم الخاصة، أود الاستفسار عن القبول: ')}`} target="_blank" rel="noopener">تواصل معنا عبر واتساب</a></div></section></BaseLayout>
<style>.page-hero{background:linear-gradient(270deg,rgba(4,34,62,.94),rgba(4,34,62,.58)),url('/images/school/07-creative-activity.jpg') center 45%/cover;color:#fff;padding:96px 0}.page-hero>div>p,.kicker{color:#d5a43f;font-weight:700}.page-hero h1,h2{font-family:var(--font-display-ar)}.page-hero h1{font-size:clamp(35px,5vw,52px);margin:10px 0}.page-hero span{display:block;max-width:700px;line-height:2;color:#eef5fb}.actions{display:flex;gap:12px;margin-top:26px}.block{padding-top:75px;padding-bottom:75px}.grid{display:grid;grid-template-columns:1.4fr .7fr;gap:65px}.grid h2,.wa-box h2{font-size:28px;color:var(--navy-dark);margin-bottom:25px}.lead,aside p{color:var(--slate);font-size:15px;line-height:2;margin-bottom:16px}aside{background:var(--cream);padding:28px;border-radius:14px;height:max-content}aside a{display:block;color:var(--navy);font-weight:700;text-decoration:none;margin:13px 0;overflow-wrap:anywhere}aside small{display:block;color:var(--slate);margin-top:20px;line-height:1.8}.wa-band{background:var(--cream);padding:65px 0}.wa-box{display:flex;align-items:center;justify-content:space-between;gap:45px}.wa-box>div>p:last-child{color:var(--slate);line-height:2}.wa-large{flex:none;background:#edf8f1;border:1px solid #cfe9d8;color:#176b38;text-decoration:none;font-weight:700;padding:15px 22px;border-radius:8px}@media(max-width:760px){.page-hero{padding:70px 0;background-position:center}.grid{grid-template-columns:1fr}.actions{flex-direction:column}.block{padding-top:55px;padding-bottom:55px}.wa-box{align-items:flex-start;flex-direction:column;gap:22px}.wa-band{padding:50px 0}}</style>