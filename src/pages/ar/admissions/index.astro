---
import BaseLayout from '../../../layouts/BaseLayout.astro';import{getEntry}from'astro:content';let settings;try{settings=await getEntry('settings','site')}catch{}const data=settings?.data;const email=data?.email||'sarhalilm-mawalih@moe.om',phone=data?.phone||'+96897817830',wa=data?.whatsappNumber||'96897817830';
---
<BaseLayout title="القبول | مدرسة صرح العلم الخاصة، مسقط" lang="ar" description="معلومات القبول والتسجيل لرياض الأطفال ١ و٢ والصفوف ١–٨ في مدرسة صرح العلم الخاصة بمسقط."><section class="page-hero"><div class="wrap"><p>القبول · رياض الأطفال ١ و٢ والصفوف ١–٨</p><h1>ابدأ رحلة طفلك في صرح العلم</h1><span>يسرّنا مساعدة الأسر الراغبة في انضمام أبنائها إلى مدرستنا. للحصول على أحدث متطلبات القبول والإرشادات، يرجى التواصل مباشرة مع مدرسة صرح العلم الخاصة.</span><div class="actions"><a class="btn-primary" href={`https://wa.me/${wa}?text=${encodeURIComponent('مرحباً، أود الحصول على معلومات عن القبول في مدرسة صرح العلم الخاصة.')}`} target="_blank" rel="noopener">اسأل عبر واتساب</a></div></div></section><section class="block wrap grid"><div><p class="kicker">معلومات القبول</p><h2>معلومات التسجيل للأسر</h2><p class="lead">يمكن للأسر الاطلاع أدناه على خطوات التسجيل والمستندات المطلوبة. وللحصول على الرسوم الدراسية الحالية، يرجى التواصل مباشرة مع مدرسة صرح العلم الخاصة ليقدم فريق القبول معلومات الرسوم المطبقة.</p></div><aside><h2>التواصل بشأن القبول</h2><p>للحصول على معلومات القبول الحالية، تواصل مباشرة مع المدرسة عبر واتساب.</p><a href={`tel:${phone}`}>☎ {phone}</a><a href={`mailto:${email}`}>✉ {email}</a><a class="wa" href={`https://wa.me/${wa}?text=${encodeURIComponent('مرحباً، لدي استفسار عن القبول في مدرسة صرح العلم الخاصة بشأن: ')}`} target="_blank" rel="noopener">راسل قسم القبول عبر واتساب</a><small>لمعرفة قيمة الرسوم الدراسية ورسوم التسجيل الحالية، يرجى التواصل مباشرة مع المدرسة.</small></aside></section><section class="registration"><div class="wrap"><div class="reg-head"><p class="kicker">التسجيل بالحضور إلى المدرسة</p><h2>خطوات التسجيل</h2><p>يسرّ مدرسة صرح العلم الخاصة استقبال أولياء الأمور لتسجيل أبنائهم بالحضور إلى مقر المدرسة.</p></div><div class="reg-grid"><article class="visit"><span class="step">١</span><h3>زيارة المدرسة</h3><p>يرجى زيارة مقر المدرسة خلال ساعات العمل المخصصة للتسجيل:</p><div class="hours"><strong>الفترة الصباحية</strong><span>8:00 صباحاً – 12:00 ظهراً</span><strong>الفترة المسائية</strong><span>4:00 مساءً – 7:00 مساءً</span></div></article><article class="docs"><span class="step">٢</span><h3>المستندات المطلوبة</h3><ul><li>نسخة من شهادة الميلاد مع إحضار الأصل للاطلاع.</li><li>نسخة من جواز سفر الأب وبطاقة الهوية.</li><li>نسخة من سجل التطعيمات الطبية للطالب.</li><li>أربع صور شخصية بحجم صور جواز السفر.</li><li>لغير العُمانيين: نسخة من تأشيرة الطالب وتأشيرة الأب.</li></ul></article><article class="fee"><span class="step">٣</span><h3>رسوم التسجيل</h3><p>تُدفع رسوم التسجيل المقررة عند التسجيل. وهي <strong>غير قابلة للاسترداد</strong>، وتُحتسب جزءاً من الرسوم الدراسية.</p><p class="note">يرجى التواصل مباشرة مع المدرسة لمعرفة قيمة رسوم التسجيل والرسوم الدراسية الحالية.</p></article></div></div></section><section class="wa-band"><div class="wrap wa-box"><div><p class="kicker">استفسارات القبول</p><h2>هل لديك سؤال عن الانضمام إلى صرح العلم؟</h2><p>يمكن لأولياء الأمور إرسال استفساراتهم عن القبول مباشرة إلى المدرسة عبر واتساب.</p></div><a class="wa-large" href={`https://wa.me/${wa}?text=${encodeURIComponent('مرحباً مدرسة صرح العلم الخاصة، أود الاستفسار عن القبول: ')}`} target="_blank" rel="noopener">تواصل معنا عبر واتساب</a></div></section></BaseLayout>
<style>.page-hero{background:linear-gradient(270deg,rgba(4,34,62,.94),rgba(4,34,62,.58)),url('/images/school/07-creative-activity.jpg') center 45%/cover;color:#fff;padding:96px 0}.page-hero>div>p,.kicker{color:#d5a43f;font-weight:700}.page-hero h1,h2{font-family:var(--font-display-ar)}.page-hero h1{font-size:clamp(35px,5vw,52px);margin:10px 0}.page-hero span{display:block;max-width:700px;line-height:2;color:#eef5fb}.actions{display:flex;gap:12px;margin-top:26px}.block{padding-top:75px;padding-bottom:75px}.grid{display:grid;grid-template-columns:1.4fr .7fr;gap:65px}.grid h2,.wa-box h2{font-size:28px;color:var(--navy-dark);margin-bottom:25px}.lead,aside p{color:var(--slate);font-size:15px;line-height:2;margin-bottom:16px}aside{background:var(--cream);padding:28px;border-radius:14px;height:max-content}aside a{display:block;color:var(--navy);font-weight:700;text-decoration:none;margin:13px 0;overflow-wrap:anywhere}aside small{display:block;color:var(--slate);margin-top:20px;line-height:1.8}.wa-band{background:var(--cream);padding:65px 0}.wa-box{display:flex;align-items:center;justify-content:space-between;gap:45px}.wa-box>div>p:last-child{color:var(--slate);line-height:2}.wa-large{flex:none;background:#edf8f1;border:1px solid #cfe9d8;color:#176b38;text-decoration:none;font-weight:700;padding:15px 22px;border-radius:8px}@media(max-width:760px){.page-hero{padding:70px 0;background-position:center}.grid{grid-template-columns:1fr}.actions{flex-direction:column}.block{padding-top:55px;padding-bottom:55px}.wa-box{align-items:flex-start;flex-direction:column;gap:22px}.wa-band{padding:50px 0}}.registration{background:#f4f7f9;padding:76px 0}.reg-head{max-width:760px;margin-bottom:34px}.reg-head h2{font-family:var(--font-display-ar);font-size:clamp(28px,3vw,38px);color:var(--navy-dark);margin:7px 0 10px}.reg-head>p:last-child{color:var(--slate);line-height:1.8}.reg-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.reg-grid article{background:#fff;border:1px solid #e1e8ed;border-radius:14px;padding:28px;box-shadow:0 7px 22px rgba(14,42,70,.04)}.step{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--navy);color:#fff;font-weight:800;margin-bottom:17px}.reg-grid h3{color:var(--navy-dark);font-size:19px;margin-bottom:10px}.reg-grid p,.reg-grid li{color:var(--slate);font-size:14px;line-height:1.75}.reg-grid ul{padding-inline-start:20px}.hours{display:grid;grid-template-columns:auto 1fr;gap:8px 15px;margin-top:18px;padding:15px;border-radius:9px;background:var(--cream);font-size:13px}.hours strong{color:var(--navy-dark)}.note{margin-top:16px;padding-top:14px;border-top:1px solid #e6ebef;font-size:12.5px!important}@media(max-width:850px){.reg-grid{grid-template-columns:1fr}.registration{padding:58px 0}}</style>