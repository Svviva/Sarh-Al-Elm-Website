---
import BaseLayout from '../../../layouts/BaseLayout.astro';import{getEntry}from'astro:content';let settings;try{settings=await getEntry('settings','site')}catch{}const data=settings?.data;const email=data?.email||'sarhalilm-mawalih@moe.om',phone=data?.phone||'+96897817830',wa=data?.whatsappNumber||'96897817830';const steps=[['أرسل استفساراً عن القبول','أخبرنا بالصف الدراسي لطفلك وبيانات التواصل المفضلة، وسيقوم فريق المدرسة بإرشادك بشأن توفر المقاعد والخطوات التالية.'],['جهّز المستندات المطلوبة','سيؤكد مكتب القبول المستندات المطلوبة لطفلك وصفه الدراسي قبل التسجيل.'],['مراجعة المدرسة والتقييم','عند الحاجة، ستقوم المدرسة بترتيب مراجعة أو تقييم مناسب للعمر أو لقاء مع الأسرة.'],['إكمال التسجيل','بعد القبول، سيرشدك فريق القبول خلال متطلبات التسجيل والالتحاق المتبقية.']];
---
<BaseLayout title="القبول | مدرسة صرح العلم الخاصة، مسقط" lang="ar" description="استفسر عن القبول في مدرسة صرح العلم الخاصة في مسقط للصفوف من الأول إلى الثامن."><section class="page-hero"><div class="wrap"><p>القبول · الصفوف ١–٨</p><h1>ابدأ رحلة طفلك في صرح العلم</h1><span>نحرص على أن تكون إجراءات القبول واضحة ومرحبة. أرسل استفسارك وسيقوم فريق المدرسة بإرشادك إلى الخطوات المناسبة.</span><div class="actions"><a class="btn-primary" href="#enquiry">ابدأ الاستفسار</a><a class="btn-ghost" href={`https://wa.me/${wa}?text=${encodeURIComponent('مرحباً، أود الحصول على معلومات عن القبول في مدرسة صرح العلم الخاصة.')}`}>واتساب القبول</a></div></div></section><section class="block wrap grid"><div><h2>إجراءات قبول بسيطة</h2>{steps.map((s,i)=><div class="step"><b>{i+1}</b><div><h3>{s[0]}</h3><p>{s[1]}</p></div></div>)}</div><aside><h2>التواصل مع القبول</h2><p>لديك سؤال قبل تعبئة النموذج؟ تواصل مع المدرسة مباشرة.</p><a href={`tel:${phone}`}>{phone}</a><a href={`mailto:${email}`}>{email}</a><a href={`https://wa.me/${wa}`}>راسلنا عبر واتساب</a><small>يرجى تأكيد الرسوم الحالية وتوفر المقاعد والمستندات المطلوبة وترتيبات التقييم مباشرة مع المدرسة.</small></aside></section><section id="enquiry" class="form-band"><div class="wrap form-grid"><div><h2>استفسار القبول</h2><p>أكمل هذا النموذج المختصر ليتمكن فريق المدرسة من التواصل معك.</p></div><form name="admission-enquiry-ar" method="POST" data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="admission-enquiry-ar"/><p class="hidden"><input name="bot-field"/></p><label>اسم ولي الأمر<input name="parent-name" required/></label><label>رقم الهاتف<input name="phone" type="tel" required/></label><label>البريد الإلكتروني<input name="email" type="email"/></label><label>الصف المطلوب<select name="grade" required><option value="">اختر الصف</option>{Array.from({length:8},(_,i)=><option value={`Grade ${i+1}`}>الصف {i+1}</option>)}</select></label><label>رسالتك<textarea name="message" rows="5"></textarea></label><button type="submit">إرسال استفسار القبول</button></form></div></section></BaseLayout>
<style>.page-hero{background:linear-gradient(120deg,#063e73,#07589e);color:#fff;padding:82px 0}.page-hero>div>p{color:#d5a43f;font-weight:700}.page-hero h1,h2{font-family:var(--font-display-ar)}.page-hero h1{font-size:clamp(35px,5vw,52px);margin:10px 0}.page-hero span{display:block;max-width:700px;line-height:2}.actions{display:flex;gap:12px;margin-top:26px}.block{padding-top:75px;padding-bottom:75px}.grid{display:grid;grid-template-columns:1.4fr .7fr;gap:65px}.grid h2,.form-grid h2{font-size:28px;color:var(--navy-dark);margin-bottom:25px}.step{display:flex;gap:17px;margin:23px 0}.step b{display:grid;place-items:center;width:38px;height:38px;flex:0 0 38px;border-radius:50%;background:var(--navy);color:#fff}.step p,aside p{color:var(--slate);font-size:14px}aside{background:var(--cream);padding:28px;border-radius:14px;height:max-content}aside a{display:block;color:var(--navy);font-weight:700;text-decoration:none;margin:13px 0;overflow-wrap:anywhere}aside small{display:block;color:var(--slate);margin-top:20px}.form-band{background:var(--cream);padding:75px 0}.form-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:55px}form{background:#fff;padding:28px;border-radius:14px}label{display:block;font-weight:700;font-size:13px;margin:12px 0}input,select,textarea{width:100%;padding:12px;margin-top:6px;border:1px solid #ccd4dc;border-radius:7px;font:inherit}button{background:var(--navy);color:#fff;border:0;border-radius:7px;padding:13px 20px;font:inherit;font-weight:700}.hidden{position:absolute;right:-9999px}@media(max-width:760px){.grid,.form-grid{grid-template-columns:1fr}.actions{flex-direction:column}.block,.form-band{padding-top:55px;padding-bottom:55px}}</style>