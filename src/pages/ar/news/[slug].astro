---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'news'>;
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={`${post.data.title_ar || post.data.title} — صرح العلم`} lang="ar">
  <article class="wrap post">
    <a class="back" href="/ar/news/">→ العودة إلى الأخبار</a>
    <div class="post-date">{post.data.date.toLocaleDateString('ar-OM', { day: '2-digit', month: 'long', year: 'numeric' })}</div>
    <h1>{post.data.title_ar || post.data.title}</h1>
    <img src={post.data.coverImage} alt="" class="cover" />
    <div class="content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post { padding: 48px 24px 80px; max-width: 720px; }
  .back { font-size: 13.5px; color: var(--navy); text-decoration: none; font-weight: 600; }
  .post-date { font-size: 13px; color: var(--gold); font-weight: 600; margin-top: 24px; }
  h1 { font-family: var(--font-display-ar); font-size: 28px; margin: 10px 0 24px; color: var(--ink); }
  .cover { width: 100%; border-radius: 10px; margin-bottom: 28px; background: linear-gradient(135deg,#E7ECF3,#D6DEE9); aspect-ratio: 16/9; object-fit: cover; }
  .content { font-size: 15.5px; line-height: 1.9; color: var(--ink); }
  .content :global(p) { margin-bottom: 16px; }
</style>
