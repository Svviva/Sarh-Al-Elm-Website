---
import BaseLayout from '../../../layouts/BaseLayout.astro';const faqs=[['ما الصفوف التي تخدمها مدرسة صرح العلم؟','يعرض الموقع حالياً مدرسة صرح العلم الخاصة كمدرسة تخدم الصفوف من الأول إلى الثامن. يرجى التواصل مع المدرسة لمعرفة توفر المقاعد في الصف المطلوب.'],['كيف أستفسر عن القبول؟','يمكنك استخدام نموذج استفسار القبول في الموقع أو الاتصال بالمدرسة أو إرسال بريد إلكتروني أو التواصل عبر واتساب.'],['ما المستندات المطلوبة للقبول؟','قد تختلف المتطلبات، وسيؤكد مكتب القبول المستندات الحالية المطلوبة لطفلك وصفه الدراسي قبل إكمال التسجيل.'],['هل يحتاج طفلي إلى تقييم؟','إذا كان التقييم أو اللقاء مطلوباً، فستشرح المدرسة الإجراءات وترتبه مباشرة مع الأسرة.'],['كيف أستفسر عن الرسوم؟','يرجى التواصل مباشرة مع المدرسة للحصول على معلومات الرسوم المعتمدة حالياً وأي ترتيبات دفع مطبقة.'],['أين تقع المدرسة؟','تقع مدرسة صرح العلم الخاصة في مسقط، سلطنة عُمان. تواصل مع المدرسة للحصول على تفاصيل الموقع أو الاتجاهات.'],['كيف أتواصل مع المدرسة بسرعة؟','يمكنك استخدام رقم الهاتف أو البريد الإلكتروني أو رابط واتساب الموجود في صفحة اتصل بنا.']];
---
<BaseLayout title="الأسئلة الشائعة | مدرسة صرح العلم الخاصة" lang="ar" description="إجابات عن الأسئلة الشائعة للأسر حول القبول والصفوف والرسوم والتواصل والحياة المدرسية في صرح العلم."><section class="hero"><div class="wrap"><p>معلومات لأولياء الأمور</p><h1>الأسئلة الشائعة</h1><span>إجابات سريعة عن الأسئلة التي تطرحها الأسر المهتمة بمدرسة صرح العلم.</span></div></section><section class="wrap faq"><div class="intro"><h2>لم تجد الإجابة؟</h2><p>فريق المدرسة جاهز لمساعدتك.</p><a href="/ar/contact/">اتصل بالمدرسة ←</a></div><div class="questions">{faqs.map(([q,a],i)=><details open={i===0}><summary>{q}</summary><p>{a}</p></details>)}</div></section><section class="admit"><div class="wrap"><h2>هل أنت مستعد للاستفسار عن مقعد لطفلك؟</h2><a class="btn-primary" href="/ar/admissions/#enquiry">ابدأ استفسار القبول</a></div></section></BaseLayout><style>.hero{background:var(--navy-dark);color:#fff;padding:72px 0}.hero p{color:#d5a43f;font-weight:700}.hero h1,h2{font-family:var(--font-display-ar)}.hero h1{font-size:clamp(35px,5vw,50px);margin:8px 0}.hero span{color:#dce7f4}.faq{display:grid;grid-template-columns:.65fr 1.35fr;gap:65px;padding-top:72px;padding-bottom:78px}.intro h2{font-size:27px;color:var(--navy-dark)}.intro p{color:var(--slate);margin:8px 0 16px}.intro a{color:var(--navy);font-weight:700;text-decoration:none}.questions{border-top:1px solid #dfe5ea}details{border-bottom:1px solid #dfe5ea}summary{cursor:pointer;list-style:none;padding:21px 0;font-weight:700}details p{color:var(--slate);padding:0 0 21px;font-size:14px;line-height:1.9}.admit{background:#eef3f7;text-align:center;padding:62px 0}.admit h2{font-size:28px;color:var(--navy-dark);margin-bottom:20px}.admit .btn-primary{background:var(--navy);color:#fff}@media(max-width:720px){.faq{grid-template-columns:1fr;gap:35px;padding-top:50px;padding-bottom:55px}.hero{padding:56px 0}}</style>