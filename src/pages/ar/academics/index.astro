import BaseLayout from '../../../layouts/BaseLayout.astro';
const needs=[['المواد حسب الصف','قائمة المواد لرياض الأطفال ١ و٢ والصفوف ١–٨، ولغة تدريس كل مادة، وعدد الحصص الأسبوعية وأي مواد اختيارية.'],['التقييم','كيفية تقييم الطلاب، وعدد التقارير خلال العام، والاختبارات، والتقييم المستمر، ونظام الدرجات وسياسة الانتقال بين الصفوف.'],['دعم التعلم','الدعم المتاح للطلاب الذين يحتاجون إلى مساعدة أكاديمية أو لغوية أو تعليمية إضافية، وكيفية حصول الأسرة عليه.'],['الواجبات والتواصل مع أولياء الأمور','توقعات الواجبات المنزلية حسب المرحلة، ووسائل التواصل مع أولياء الأمور، ومواعيد التقارير واجتماعات أولياء الأمور والمعلمين.'],['التقويم واليوم الدراسي','مواعيد الفصول الدراسية، وساعات الدوام، ومدة الحصص، وأوقات الاستراحة وأي اختلافات بين الصفوف.']];
---
<BaseLayout title="التعليم | مدرسة صرح العلم الخاصة، مسقط" lang="ar" description="تعرّف على الرحلة التعليمية لرياض الأطفال ١ و٢ والصفوف ١–٨ في مدرسة صرح العلم الخاصة في مسقط، بما في ذلك مناهج وموارد الرياضيات والعلوم التابعة لوزارة التربية والتعليم والمطورة بالتعاون مع كامبريدج.">
<section class="hero"><div class="wrap"><p>التعليم · رياض الأطفال ١ و٢ والصفوف ١–٨</p><h1>رحلة تعليمية واضحة، من الأسس القوية إلى الاستقلالية المتنامية</h1><span>تدعم صرح العلم الطلاب من رياض الأطفال ١ و٢ إلى الصف الثامن في بيئة مدرسية ثنائية اللغة، وفق المتطلبات التعليمية المعتمدة في سلطنة عُمان.</span></div></section>
<section class="intro wrap"><div><p class="kicker">نهجنا التعليمي</p><h2>تعلم هادف يبني الثقة والفضول</h2></div><p>نهدف إلى مساعدة الطلاب على بناء أسس متينة، والتواصل بفاعلية، وتنمية الاستقلالية والمشاركة النشطة في التعلم، مع تقديم معلومات واضحة للأسر حول تجربة أبنائهم التعليمية في المدرسة.</p></section>
<section class="photo-story wrap" aria-label="التعلم في صرح العلم"><figure><img src="/images/school/02-student-learning.jpg" alt="طلاب صرح العلم يشاركون في نشاط تعلم عملي" loading="lazy" /><figcaption>التعلم العملي يشجع الفضول والمشاركة والتعاون.</figcaption></figure><figure><img src="/images/school/12-digital-learning.jpg" alt="طلاب صرح العلم يشاركون في التعلم الرقمي" loading="lazy" /><figcaption>تدعم خبرات التعلم المتنوعة الثقة والاستقلالية المتنامية.</figcaption></figure></section>
<section class="cambridge"><div class="wrap cambridge-grid"><div><p class="kicker">الرياضيات والعلوم</p><h2>منهج بمعايير دولية وملاءمة للسياق العُماني</h2></div><div><p>تدرّس مدرسة صرح العلم الخاصة مناهج وموارد تعلم الرياضيات والعلوم التابعة لوزارة التربية والتعليم في سلطنة عُمان، والتي طُوّرت من خلال شراكة الوزارة مع مطبعة وتقييم جامعة كامبريدج.</p><p>يجمع هذا المشروع الوطني بين الأساليب الدولية في تعليم الرياضيات والعلوم وبين الثقافة والقيم والسياق العُماني. وتهدف المناهج والموارد التعليمية إلى تعزيز المعرفة وتنمية مهارات مثل حل المشكلات والتفكير الناقد والاستقصاء العلمي والتعلم النشط.</p></div></div></section>
<section class="journey"><div class="wrap"><p class="kicker">البرامج والمراحل</p><h2>من رياض الأطفال إلى الصف الثامن</h2><div class="program-grid">
<article><div class="program-head"><span>المرحلة المبكرة</span><h3>رياض الأطفال ١ و٢</h3><p class="time">الدوام: 7:30 صباحاً – 12:00 ظهراً</p></div><div class="program-body"><h4>المناهج المقدمة</h4><ul><li>كتب إثرائية: نور البيان وفتح الرحمن</li><li>اللغة الإنجليزية</li><li>اللغة العربية والرياضيات (بساتين المعرفة)</li><li>التربية الإسلامية (المنهج العُماني)</li><li>حفظ القرآن الكريم</li></ul><h4>العمر</h4><p>رياض الأطفال ١: من عمر 3 سنوات ونصف<br/>رياض الأطفال ٢: من عمر 4 سنوات ونصف</p><h4>المرافق</h4><p>فصول ملونة، منطقة للأنشطة واللعب، ركن للقراءة والقصة، منطقة للفنون والأشغال الإبداعية، غرفة سمعية بصرية، سبورات ذكية وأدوات تعلم رقمية، منطقة لتناول الطعام والوجبات الخفيفة، منطقة للعب الحسي، وأنظمة أمن ومراقبة بالكاميرات.</p></div></article>
<article><div class="program-head"><span>المستوى الأول</span><h3>الصفوف ١–٤</h3><p class="time">الدوام: 7:00 صباحاً – 1:30 ظهراً</p></div><div class="program-body"><h4>المنهج ثنائي اللغة</h4><ul><li>اللغة العربية</li><li>التربية الإسلامية</li><li>الرياضيات والعلوم واللغة الإنجليزية (منهج كامبريدج)</li><li>المهارات الفردية: الهوية والمواطنة، الفنون البصرية، الرياضة، الموسيقى، وتقنية المعلومات</li></ul><h4>المرافق</h4><p>مصادر التعلم، ساحة للتمارين البدنية، والمكتبة.</p></div></article>
<article><div class="program-head"><span>المستوى الثاني</span><h3>الصفوف ٥–٨</h3><p class="time">الدوام: 7:00 صباحاً – 1:30 ظهراً</p></div><div class="program-body"><h4>المنهج ثنائي اللغة</h4><ul><li>اللغة العربية</li><li>التربية الإسلامية</li><li>الرياضيات والعلوم واللغة الإنجليزية (منهج كامبريدج)</li><li>المهارات الفردية: الهوية والمواطنة، الفنون البصرية، الرياضة، الموسيقى، وتقنية المعلومات</li></ul><h4>المرافق</h4><p>مصادر التعلم، ساحة للتمارين البدنية، المكتبة، ومختبر العلوم.</p></div></article>
</div></div></section>
<section class="principles wrap"><p class="kicker">ما يوجّه التعلم</p><h2>تجربة مدرسية متوازنة</h2><div class="principle-grid"><article><h3>أسس قوية</h3><p>تنمو المعارف والمهارات الأساسية بصورة تدريجية مع انتقال الطالب بين الصفوف.</p></article><article><h3>تعلم ثنائي اللغة</h3><p>تمثل اللغة والتواصل جزءاً مهماً من تجربة المدرسة ومن النمو الشامل للطالب.</p></article><article><h3>المشاركة الفاعلة</h3><p>نشجع الطلاب على طرح الأسئلة والتعبير عن الأفكار وممارسة المهارات وتحمل مسؤولية أكبر عن تعلمهم.</p></article><article><h3>النمو والرفاه</h3><p>يدعم التقدم الأكاديمي مناخ مدرسي محترم يساعد الطلاب على بناء الثقة والشعور بالانتماء.</p></article></div></section>
<section class="calendar-note"><div class="wrap calendar-box"><div><p class="kicker">التقويم الأكاديمي</p><h2>وفق تقويم وزارة التعليم</h2></div><p>تتبع المدرسة التقويم الأكاديمي المعتمد من وزارة التعليم في سلطنة عُمان للمدارس الخاصة المطبقة لنظام التقويم الحكومي. لذلك يُرجى الرجوع إلى إعلانات الوزارة والمدرسة لمعرفة المواعيد المعتمدة لكل عام دراسي وأي تحديثات رسمية.</p></div></section>
<section class="cta"><div class="wrap"><h2>لديك سؤال عن صف طفلك؟</h2><p>يمكن للأسر التواصل مباشرة مع المدرسة للحصول على المعلومات الأكاديمية الحالية.</p><a class="btn-primary" href="/ar/contact/">اسأل المدرسة</a></div></section>
</BaseLayout>
