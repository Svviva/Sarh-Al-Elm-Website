---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="عن المدرسة — صرح العلم" lang="ar">
  <section class="page-hero"><div class="wrap"><p class="eyebrow">عن المدرسة</p><h1>مجتمع مبني على أسس قوية</h1><p class="sub">تخدم مدرسة صرح العلم الخاصة طلاب الصفوف من ١ إلى ٨ في مسقط ضمن بيئة مدرسية ثنائية اللغة.</p></div></section>
  <section class="block wrap two-col"><div><h2>قصتنا</h2><p>صرح العلم مدرسة خاصة تخدم طلاب الصفوف من ١ إلى ٨ في مسقط. ويعكس اسمنا — بمعنى "صرح المعرفة" — فكرة أن التعلم يُبنى خطوة بخطوة، وصفاً بعد صف.</p><p>نسعى إلى توفير تجربة مدرسية ثنائية اللغة وهادفة، يستطيع الطلاب من خلالها بناء المعرفة ومهارات التواصل والثقة وعادات التعلم الإيجابية.</p></div><div><h2>رسالتنا</h2><p>نهدف إلى تنمية متعلمين واثقين وقادرين، يفكرون بشكل نقدي، ويتواصلون باللغتين العربية والإنجليزية، ويحملون قيماً راسخة في كل ما يسعون إليه مستقبلاً.</p><h2 class="mt">معلومات المنهج</h2><p>تدرّس مدرسة صرح العلم الخاصة مناهج وموارد تعلم الرياضيات والعلوم التابعة لوزارة التربية والتعليم في سلطنة عُمان، والتي طُوّرت من خلال شراكة الوزارة مع مطبعة وتقييم جامعة كامبريدج.</p><a class="text-link" href="/ar/academics/">استكشف التعليم ←</a></div></section>
</BaseLayout>
<style>.page-hero{position:relative;background:linear-gradient(270deg,rgba(4,34,62,.92),rgba(4,34,62,.62)),url('/images/school/03-school-celebration.jpg') center 60%/cover;color:#fff;padding:92px 0}.page-hero .eyebrow{color:#d5a43f;font-size:14px;margin-bottom:12px}.page-hero h1{font-family:var(--font-display-ar);font-size:clamp(34px,5vw,48px);font-weight:600;margin-bottom:14px;max-width:640px}.page-hero .sub{color:#eef5fb;max-width:560px;font-size:16px;line-height:1.9}.block{padding:64px 24px}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:48px}h2{font-family:var(--font-display-ar);font-size:20px;margin-bottom:12px;color:var(--navy-dark)}h2.mt{margin-top:28px}p{color:var(--ink);font-size:15px;line-height:1.8;margin-bottom:14px}.text-link{color:var(--navy);font-weight:700;text-decoration:none}@media(max-width:800px){.page-hero{padding:70px 0;background-position:center}.two-col{grid-template-columns:1fr}}</style>