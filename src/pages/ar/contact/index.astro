---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

let settings;
try { settings = await getEntry('settings', 'site'); } catch {}
const data = settings?.data;
---
<BaseLayout title="اتصل بنا — صرح العلم" lang="ar">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">اتصل بنا</p>
      <h1>يسعدنا التواصل معك</h1>
    </div>
  </section>

  <section class="block wrap two-col">
    <div class="info">
      <div class="row">
        <h3>العنوان</h3>
        <p>{data?.address_ar || data?.address || 'مسقط، عُمان'}</p>
      </div>
      <div class="row">
        <h3>الهاتف</h3>
        <p><a href={`tel:${data?.phone || ''}`}>{data?.phone || '+968 XXXX XXXX'}</a></p>
      </div>
      <div class="row">
        <h3>البريد الإلكتروني</h3>
        <p><a href={`mailto:${data?.email || ''}`}>{data?.email || 'info@sarhalelm.om'}</a></p>
      </div>
    </div>
    <div class="map">
      {data?.mapEmbedUrl
        ? <iframe src={data.mapEmbedUrl} loading="lazy" title="موقع المدرسة"></iframe>
        : <div class="map-placeholder">ستظهر الخريطة هنا بمجرد إضافة رابط الموقع في الإعدادات.</div>}
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background: var(--navy); color: #fff; padding: 64px 0; }
  .page-hero .eyebrow { color: #BFD8F0; font-size: 14px; margin-bottom: 12px; }
  .page-hero h1 { font-family: var(--font-display-ar); font-size: 30px; font-weight: 600; }
  .block { padding: 64px 24px; }
  .two-col { display: grid; grid-template-columns: 1fr 1.4fr; gap: 48px; align-items: start; }
  .row { margin-bottom: 28px; }
  .row h3 { font-size: 13px; color: var(--slate); margin-bottom: 6px; font-weight: 600; }
  .row p { font-size: 16px; }
  .row a { color: var(--navy); text-decoration: none; font-weight: 600; }
  .map iframe { width: 100%; height: 340px; border: 0; border-radius: 10px; }
  .map-placeholder {
    height: 340px; background: var(--cream); border-radius: 10px; display: flex;
    align-items: center; justify-content: center; color: var(--slate); font-size: 14px; text-align: center; padding: 20px;
  }
  @media (max-width: 800px) { .two-col { grid-template-columns: 1fr; } }
</style>
