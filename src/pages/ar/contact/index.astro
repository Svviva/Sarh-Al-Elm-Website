---
import BaseLayout from '../../../layouts/BaseLayout.astro';import{getEntry}from'astro:content';let settings;try{settings=await getEntry('settings','site')}catch{}const data=settings?.data;const phone=data?.phone||'+96897817830',email=data?.email||'sarhalilm-mawalih@moe.om',wa=data?.whatsappNumber||'96897817830';
---
<BaseLayout title="اتصل بنا | مدرسة صرح العلم الخاصة، مسقط" lang="ar" description="تواصل مع مدرسة صرح العلم الخاصة في مسقط عبر الهاتف أو البريد الإلكتروني أو واتساب أو نموذج الاستفسار."><section class="hero"><div class="wrap"><p>اتصل بصرح العلم</p><h1>كيف يمكننا مساعدتك؟</h1><span>سواء كان استفسارك عن القبول أو الحياة المدرسية أو معلومات عامة، يسعد فريقنا التواصل معك.</span></div></section><section class="wrap grid"><div><h2>تواصل معنا</h2><div class="detail">الموقع<strong>{data?.address_ar||data?.address||'مسقط، عُمان'}</strong></div><div class="detail">الهاتف<a href={`tel:${phone}`}>{phone}</a></div><div class="detail">البريد الإلكتروني<a href={`mailto:${email}`}>{email}</a></div><a class="wa" href={`https://wa.me/${wa}?text=${encodeURIComponent('مرحباً، أود الاستفسار عن مدرسة صرح العلم الخاصة.')}`}>تحدث مع المدرسة عبر واتساب</a></div><form name="contact-enquiry-ar" method="POST" data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="contact-enquiry-ar"/><p class="hidden"><input name="bot-field"/></p><h2>أرسل لنا رسالة</h2><label>الاسم<input name="name" required/></label><label>رقم الهاتف<input name="phone" type="tel"/></label><label>البريد الإلكتروني<input name="email" type="email" required/></label><label>نوع الاستفسار<select name="type"><option>استفسار عام</option><option>القبول</option><option>التعليم</option><option>الحياة المدرسية</option><option>أخرى</option></select></label><label>رسالتك<textarea name="message" rows="6" required></textarea></label><button type="submit">إرسال الرسالة</button></form></section><section class="map"><div class="wrap">{data?.mapEmbedUrl?<iframe src={data.mapEmbedUrl} loading="lazy" title="موقع مدرسة صرح العلم"></iframe>:<div class="placeholder"><strong>موقع المدرسة</strong><p>{data?.address_ar||data?.address||'مسقط، عُمان'}</p><small>يمكن عرض الخريطة هنا بعد إضافة رابط الخريطة المعتمد للمدرسة إلى إعدادات الموقع.</small></div>}</div></section></BaseLayout>
<style>.hero{background:var(--navy-dark);color:#fff;padding:75px 0}.hero p{color:#d5a43f;font-weight:700}.hero h1,h2{font-family:var(--font-display-ar)}.hero h1{font-size:clamp(35px,5vw,50px);margin:8px 0}.hero span{color:#dce7f4}.grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:65px;padding-top:72px;padding-bottom:72px}.grid h2{font-size:28px;color:var(--navy-dark);margin-bottom:25px}.detail{padding:16px 0;border-bottom:1px solid #e5e9ee;font-size:12px;color:var(--slate)}.detail strong,.detail a{display:block;color:var(--ink);font-size:15px;text-decoration:none;margin-top:4px}.wa{display:block;background:#edf8f1;color:#176b38;padding:14px;border-radius:8px;text-decoration:none;font-weight:700;margin-top:25px}form{background:var(--cream);padding:28px;border-radius:14px}label{display:block;font-size:13px;font-weight:700;margin-top:13px}input,select,textarea{width:100%;padding:12px;margin-top:6px;border:1px solid #ccd4dc;border-radius:7px;font:inherit}button{background:var(--navy);color:#fff;border:0;border-radius:7px;padding:13px 20px;font:inherit;font-weight:700;margin-top:18px}.hidden{position:absolute;right:-9999px}.map{background:var(--cream);padding:50px 0 70px}.map iframe,.placeholder{width:100%;height:350px;border:0;border-radius:14px}.placeholder{background:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:25px}.placeholder strong{font-size:24px;color:var(--navy-dark)}.placeholder small{color:var(--slate);max-width:500px}@media(max-width:760px){.grid{grid-template-columns:1fr;gap:38px;padding-top:55px;padding-bottom:55px}.hero{padding:58px 0}}</style>