---
import BaseLayout from '../../../layouts/BaseLayout.astro';import{getEntry}from'astro:content';let settings;try{settings=await getEntry('settings','site')}catch{}const data=settings?.data;const phone=data?.phone||'+96897817830',email=data?.email||'sarhalilm-mawalih@moe.om',wa=data?.whatsappNumber||'96897817830';
---
<BaseLayout title="اتصل بنا | مدرسة صرح العلم الخاصة، مسقط" lang="ar" description="تواصل مع مدرسة صرح العلم الخاصة في مسقط، سلطنة عُمان، عبر الهاتف أو البريد الإلكتروني أو واتساب."><section class="hero"><div class="wrap"><p>تواصل مع صرح العلم</p><h1>كيف يمكننا مساعدتك؟</h1><span>سواء كان استفسارك عن القبول أو الشؤون الأكاديمية أو الحياة المدرسية أو معلومات عامة، يسعد فريقنا مساعدتك.</span></div></section><section class="wrap grid"><div><p class="kicker">بيانات المدرسة</p><h2>تواصل معنا</h2><div class="detail">الموقع<strong>{data?.address_ar||data?.address||'مسقط، سلطنة عُمان'}</strong></div><div class="detail">الهاتف<a href={`tel:${phone}`}>{phone}</a></div><div class="detail">البريد الإلكتروني<a href={`mailto:${email}`}>{email}</a></div>{data?.instagramUrl&&<a class="social" href={data.instagramUrl} target="_blank" rel="noopener">زوروا حسابنا على إنستغرام ←</a>}</div><div class="wa-card"><p class="kicker">استفسارات أولياء الأمور</p><h2>راسل المدرسة عبر واتساب</h2><p>للاستفسار عن القبول أو الشؤون الأكاديمية أو الحياة المدرسية أو أي استفسارات أخرى، يمكن لأولياء الأمور التواصل مباشرة مع مدرسة صرح العلم الخاصة عبر واتساب.</p><a class="wa" href={`https://wa.me/${wa}?text=${encodeURIComponent('مرحباً مدرسة صرح العلم الخاصة، أود الاستفسار عن: ')}`} target="_blank" rel="noopener">تواصل معنا عبر واتساب</a><small>سيتم فتح محادثة واتساب مع رسالة جاهزة لتكمل استفسارك.</small></div></section><section class="map"><div class="wrap">{data?.mapEmbedUrl?<iframe src={data.mapEmbedUrl} loading="lazy" title="موقع مدرسة صرح العلم الخاصة"></iframe>:<div class="placeholder"><strong>موقع المدرسة</strong><p>{data?.address_ar||data?.address||'مسقط، سلطنة عُمان'}</p><small>يمكن عرض الخريطة هنا بعد إضافة رابط الخريطة المعتمد للمدرسة إلى إعدادات الموقع.</small></div>}</div></section></BaseLayout>
<style>.hero{background:var(--navy-dark);color:#fff;padding:75px 0}.hero p,.kicker{color:#d5a43f;font-weight:700}.hero h1,h2{font-family:var(--font-display-ar)}.hero h1{font-size:clamp(35px,5vw,50px);margin:8px 0}.hero span{color:#dce7f4}.grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:65px;padding-top:72px;padding-bottom:72px}.grid h2{font-size:28px;color:var(--navy-dark);margin-bottom:25px}.detail{padding:16px 0;border-bottom:1px solid #e5e9ee;font-size:12px;color:var(--slate)}.detail strong,.detail a{display:block;color:var(--ink);font-size:15px;text-decoration:none;margin-top:4px}.social{display:inline-block;color:var(--navy);font-weight:700;text-decoration:none;margin-top:18px}.wa-card{background:var(--cream);border:1px solid #e3e7eb;padding:30px;border-radius:14px}.wa-card>p{color:var(--slate);line-height:2}.wa{display:inline-block;background:#edf8f1;border:1px solid #cfe9d8;color:#176b38;padding:15px 20px;border-radius:8px;text-decoration:none;font-weight:700;margin-top:22px}.wa-card small{display:block;color:var(--slate);margin-top:15px;line-height:1.8}.map{background:var(--cream);padding:50px 0 70px}.map iframe,.placeholder{width:100%;height:350px;border:0;border-radius:14px}.placeholder{background:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:25px}.placeholder strong{font-size:24px;color:var(--navy-dark)}.placeholder small{color:var(--slate);max-width:500px}@media(max-width:760px){.grid{grid-template-columns:1fr;gap:38px;padding-top:55px;padding-bottom:55px}.hero{padding:58px 0}.wa-card{padding:24px}}</style>