---
import BaseLayout from '../../layouts/BaseLayout.astro';import{getCollection,getEntry}from'astro:content';let settings;try{settings=await getEntry('settings','site')}catch{}const p=settings?.data;let testimonials=[];try{testimonials=(await getCollection('testimonials')).sort((a,b)=>(a.data.order||99)-(b.data.order||99))}catch{}let slides=[];try{slides=(await getCollection('hero-slides')).sort((a,b)=>a.data.order-b.data.order)}catch{}let newsItems=[];try{newsItems=(await getCollection('news')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3)}catch{}let singles=[],albums=[];try{singles=await getCollection('gallery-singles');albums=await getCollection('gallery-albums')}catch{}const galleryPreview=[...albums.map(a=>({image:a.data.coverImage})),...singles.map(s=>({image:s.data.image}))].slice(0,5);const heroSlides=slides.map(s=>({image:s.data.image,headline:s.data.headline_ar||s.data.headline,subhead:s.data.subhead_ar||s.data.subhead}));const schoolMoments=[{image:'/images/school/04-student-project.jpg',title:'التعلم بالممارسة',text:'ينمو الفضول من خلال التعلم النشط والتجارب العملية.'},{image:'/images/school/12-digital-learning.jpg',title:'تنمية المهارات',text:'يبني الطلاب الثقة من خلال خبرات تعلم متنوعة.'}];
---
<BaseLayout title="مدرسة صرح العلم الخاصة | مسقط" lang="ar" description="اكتشف مدرسة صرح العلم الخاصة في مسقط، مجتمعاً تعليمياً مرحباً للصفوف من الأول إلى الثامن، يهتم بالتعلم القوي والتعليم ثنائي اللغة ومسار قبول واضح.">
<section class="hero" data-slides={JSON.stringify(heroSlides)}><div class="hero-bg"></div><div class="hero-overlay"></div><div class="wrap hero-content"><div class="hero-copy"><p class="eyebrow">مدرسة صرح العلم الخاصة · مسقط</p><h1 id="hero-title">{heroSlides[0]?.headline||'حيث يتحول الفضول إلى إنجاز'}</h1><p class="sub" id="hero-sub">{heroSlides[0]?.subhead||'مجتمع تعليمي داعم تنمو فيه الأسس القوية والتعلم ثنائي اللغة والثقة لدى أبنائنا.'}</p><div class="hero-ctas"><a href="/ar/admissions/" class="btn-primary">ابدأ طلب القبول</a><a href="/ar/contact/" class="btn-ghost">استفسر عن المدرسة</a></div><p class="hero-note">رياض الأطفال ١ و٢ والصفوف ١–٨ · نرحب باستفسارات الأسر الراغبة في الالتحاق</p></div></div>{heroSlides.length>1&&<div class="hero-controls">{heroSlides.map((_,i)=><button class={i===0?'active':''} data-slide={i} aria-label={`عرض الشريحة ${i+1}`}></button>)}</div>}</section>
<section class="quick-actions"><div class="wrap quick-grid"><a href="/ar/admissions/"><strong>القبول</strong><span>تعرف على خطوات التقديم ←</span></a><a href="/ar/academics/"><strong>التعليم</strong><span>استكشف التعلم في صرح العلم ←</span></a><a href="/ar/school-life/"><strong>الحياة المدرسية</strong><span>شاهد مجتمعنا في العمل ←</span></a><a href="/ar/contact/"><strong>اتصل بنا</strong><span>تواصل مع فريق المدرسة ←</span></a></div></section>
<section class="block wrap welcome"><div class="principal-photo" style={p?.principalPhoto?`background-image:url(${p.principalPhoto})`:''}></div><div class="principal-text"><p class="eyebrow-sm">ترحيب حار</p><h2>نساعد كل متعلم على النمو بثقة</h2><p class="msg">{p?.principalMessage_ar||'نسعى في صرح العلم إلى توفير تجربة مدرسية آمنة وهادفة ومشجعة، يبني فيها الأطفال المعرفة والشخصية والفضول والثقة.'}</p><a href="/ar/about/" class="text-link">اكتشف مدرستنا ←</a></div></section>
<section class="school-story"><div class="wrap story-grid"><div class="story-copy"><p class="eyebrow-sm">التعلم في الواقع</p><h2>لحظات حقيقية من مجتمع مدرستنا</h2><p>من الاستكشاف العملي إلى التعلم الرقمي، نشجع الطلاب على المشاركة والتعاون والنمو بثقة خلال تجربتهم المدرسية.</p><a href="/ar/school-life/" class="text-link">استكشف الحياة المدرسية ←</a></div><div class="story-photos">{schoolMoments.map((m,i)=><figure class={i===0?'story-main':'story-side'}><img src={m.image} alt={m.title} loading="lazy"/><figcaption><strong>{m.title}</strong><span>{m.text}</span></figcaption></figure>)}</div></div></section>
<section class="admissions-band"><div class="wrap admissions-inner"><div><p class="eyebrow-light">القبول</p><h2>هل تبحث عن المدرسة المناسبة لطفلك؟</h2><p>ابدأ باستفسار بسيط، وسيرشدك فريقنا إلى الخطوات التالية ويجيب عن أسئلتك حول الالتحاق بصرح العلم.</p></div><div class="admissions-actions"><a href="/ar/admissions/" class="btn-primary">ابدأ إجراءات القبول</a><a href="/ar/contact/" class="btn-outline-light">اطرح سؤالاً</a></div></div></section>
<section class="block wrap"><div class="section-head"><div><p class="eyebrow-sm">ابقَ على اطلاع</p><h2>آخر الأخبار</h2></div><a href="/ar/news/">عرض جميع الإعلانات ←</a></div><div class="news-grid">{newsItems.length===0&&<p class="empty">ستظهر أخبار المدرسة وإعلاناتها هنا.</p>}{newsItems.map(post=><a class="news-card" href={`/ar/news/${post.id}/`}><div class="news-thumb" style={`background-image:url(${post.data.coverImage})`}></div><div class="news-body"><div class="news-date">{post.data.date.toLocaleDateString('ar-OM',{day:'2-digit',month:'short',year:'numeric'})}</div><h3>{post.data.title_ar||post.data.title}</h3><span>اقرأ المزيد ←</span></div></a>)}</div></section>
<section class="gallery-section"><div class="block wrap"><div class="section-head"><div><p class="eyebrow-sm">مجتمعنا</p><h2>الحياة في صرح العلم</h2></div><a href="/ar/gallery/">عرض المعرض الكامل ←</a></div><div class="gallery-grid">{galleryPreview.map((g,i)=><a href="/ar/gallery/" class="g-item" aria-label={`صورة من المدرسة ${i+1}`} style={`background-image:url(${g.image})`}></a>)}</div></div></section>
{testimonials.length>0&&<section class="block wrap testimonials"><div class="section-head"><div><p class="eyebrow-sm">أصوات أولياء الأمور</p><h2>ماذا تقول الأسر</h2></div></div><div class="testimonial-grid">{testimonials.map(t=><div class="testimonial-card"><p class="quote">“{t.data.quote_ar||t.data.quote}”</p><p class="name">{t.data.parentName}</p></div>)}</div></section>}
<section class="final-cta"><div class="wrap"><p class="eyebrow-light">اتخذ الخطوة التالية</p><h2>تعال واكتشف صرح العلم</h2><p>يسعدنا التواصل مع أسرتك ومساعدتك على معرفة المزيد عن مدرستنا.</p><div class="hero-ctas center"><a href="/ar/admissions/" class="btn-primary">استفسر عن القبول</a><a href="/ar/contact/" class="btn-outline-light">اتصل بالمدرسة</a></div></div></section></BaseLayout>
<script>const hero=document.querySelector('.hero');if(hero){const slides=JSON.parse(hero.getAttribute('data-slides')||'[]');const bg=hero.querySelector('.hero-bg'),title=document.getElementById('hero-title'),sub=document.getElementById('hero-sub'),dots=[...hero.querySelectorAll('[data-slide]')];let current=0,timer;const show=i=>{if(!slides.length)return;current=i;bg.style.backgroundImage=`url(${slides[i].image})`;title.textContent=slides[i].headline;sub.textContent=slides[i].subhead;dots.forEach((d,n)=>d.classList.toggle('active',n===i))};const start=()=>{if(slides.length>1)timer=setInterval(()=>show((current+1)%slides.length),6000)};dots.forEach(d=>d.addEventListener('click',()=>{clearInterval(timer);show(Number(d.dataset.slide));start()}));show(0);start();}</script>
<style>
.hero{position:relative;min-height:650px;display:flex;align-items:center;overflow:hidden;background:#05386b}.hero-bg{position:absolute;inset:0;background-size:cover;background-position:center}.hero-overlay{position:absolute;inset:0;background:linear-gradient(270deg,rgba(3,35,66,.94),rgba(5,56,107,.72) 48%,rgba(5,56,107,.15))}.hero-content{position:relative;z-index:2;color:#fff}.hero-copy{max-width:650px;padding:96px 0}.eyebrow{font-size:13px;color:#dbe9f7;margin-bottom:18px}.hero h1{font-family:var(--font-display-ar);font-size:clamp(38px,5vw,58px);line-height:1.35;margin-bottom:20px}.hero .sub{font-size:17px;line-height:2;color:#eef5fb;margin-bottom:28px}.hero-ctas{display:flex;gap:12px;flex-wrap:wrap}.hero-note{margin-top:20px;font-size:13px;color:#dbe9f7}.hero-controls{position:absolute;z-index:4;bottom:28px;left:50%;transform:translateX(-50%);display:flex;gap:9px}.hero-controls button{width:28px;height:4px;border:0;background:rgba(255,255,255,.4);padding:0}.hero-controls button.active{background:#fff}.btn-outline-light{display:inline-block;border:1px solid rgba(255,255,255,.65);color:#fff;padding:12px 24px;border-radius:7px;font-weight:700;text-decoration:none}.quick-actions{background:#fff;box-shadow:0 8px 30px rgba(14,42,70,.08)}.quick-grid{display:grid;grid-template-columns:repeat(4,1fr)}.quick-grid a{padding:28px 24px;text-decoration:none;border-left:1px solid #e8edf2}.quick-grid strong{display:block;color:var(--navy-dark);font-size:18px}.quick-grid span{font-size:12px;color:var(--slate)}.block{padding-top:84px;padding-bottom:84px}.welcome{display:grid;grid-template-columns:280px 1fr;gap:56px;align-items:center}.principal-photo{width:280px;height:320px;border-radius:18px;background:#d6e1ee center/cover}.eyebrow-sm,.eyebrow-light{font-size:12px;font-weight:700;margin-bottom:10px}.eyebrow-sm{color:var(--gold)}.eyebrow-light{color:#cfe2f5}.principal-text h2,.section-head h2,.admissions-band h2,.final-cta h2,.story-copy h2{font-family:var(--font-display-ar);color:var(--navy-dark);font-size:clamp(27px,3vw,38px);line-height:1.5}.principal-text .msg{color:var(--slate);line-height:2;margin:18px 0}.text-link,.section-head a{color:var(--navy);font-weight:700;text-decoration:none}.school-story{background:#f3f6f8;padding:84px 0}.story-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:58px;align-items:center}.story-copy p:not(.eyebrow-sm){color:var(--slate);line-height:2;margin:18px 0}.story-photos{display:grid;grid-template-columns:1.2fr .8fr;gap:14px}.story-photos figure{margin:0;position:relative;overflow:hidden;border-radius:16px;min-height:390px;box-shadow:0 18px 45px rgba(4,34,62,.12)}.story-photos img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover}.story-photos figcaption{position:absolute;right:14px;left:14px;bottom:14px;padding:13px 14px;border-radius:10px;background:rgba(4,34,62,.86);color:#fff}.story-photos figcaption strong,.story-photos figcaption span{display:block}.story-photos figcaption span{font-size:12px;color:#dbe9f7;margin-top:3px}.admissions-band{background:var(--navy-dark);color:#fff;padding:64px 0}.admissions-inner{display:flex;justify-content:space-between;align-items:center;gap:50px}.admissions-band h2{color:#fff}.admissions-band p{color:#dbe9f7}.admissions-actions{display:flex;gap:12px;flex-wrap:wrap}.section-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:34px}.news-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.news-card{border:1px solid #e7ebef;border-radius:14px;overflow:hidden;text-decoration:none;background:#fff}.news-thumb{height:190px;background:#e8edf2 center/cover}.news-body{padding:22px}.news-date{font-size:12px;color:var(--gold)}.news-body h3{font-size:16px;margin:8px 0}.news-body span{font-size:12px;color:var(--navy)}.gallery-section{background:var(--cream)}.gallery-grid{display:grid;grid-template-columns:1.35fr 1fr 1fr;grid-template-rows:180px 180px;gap:12px}.g-item{background:#d6e1ee center/cover;border-radius:12px}.g-item:first-child{grid-row:span 2}.testimonial-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}.testimonial-card{border:1px solid #e7ebef;border-radius:14px;padding:30px}.quote{line-height:1.9;font-style:italic}.name{font-weight:700;color:var(--navy);margin-top:14px}.final-cta{text-align:center;background:linear-gradient(135deg,#074b8a,#05386b);color:#fff;padding:82px 20px}.final-cta h2{color:#fff}.final-cta>div>p:not(.eyebrow-light){max-width:650px;margin:16px auto 26px;color:#dbe9f7}.center{justify-content:center}@media(max-width:900px){.quick-grid{grid-template-columns:1fr 1fr}.welcome{grid-template-columns:220px 1fr}.principal-photo{width:220px;height:270px}.story-grid{grid-template-columns:1fr}.admissions-inner{flex-direction:column;align-items:flex-start}.news-grid{grid-template-columns:1fr 1fr}.gallery-grid{grid-template-columns:1fr 1fr;grid-template-rows:auto}.g-item:first-child{grid-row:auto}}@media(max-width:600px){.hero{min-height:560px}.hero-copy{padding:72px 0}.hero h1{font-size:36px}.hero .sub{font-size:16px}.hero-ctas>a{width:100%;text-align:center}.quick-grid,.welcome,.news-grid,.gallery-grid,.testimonial-grid,.story-photos{grid-template-columns:1fr}.quick-grid a{border-left:0;border-bottom:1px solid #e8edf2;padding:20px 18px}.principal-photo{width:100%;height:340px}.block,.school-story{padding-top:58px;padding-bottom:58px}.story-grid{gap:32px}.story-photos figure{min-height:280px}.section-head{align-items:flex-start;flex-direction:column}.g-item{min-height:220px}.admissions-actions{width:100%}.admissions-actions a{width:100%;text-align:center}}</style>