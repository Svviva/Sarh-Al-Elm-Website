---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
let settings; try { settings = await getEntry('settings','site'); } catch {} const p=settings?.data;
let testimonials=[];try{testimonials=(await getCollection('testimonials')).sort((a,b)=>(a.data.order||99)-(b.data.order||99))}catch{}
let slides=[];try{slides=(await getCollection('hero-slides')).sort((a,b)=>a.data.order-b.data.order)}catch{}
let newsItems=[];try{newsItems=(await getCollection('news')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3)}catch{}
let singles=[];let albums=[];try{singles=await getCollection('gallery-singles');albums=await getCollection('gallery-albums')}catch{}
const galleryPreview=[...albums.map(a=>({image:a.data.coverImage})),...singles.map(s=>({image:s.data.image}))].slice(0,5);
const heroSlides=slides.map(s=>({image:s.data.image,headline:s.data.headline,subhead:s.data.subhead}));
const schoolMoments=[
{image:'/images/school/04-student-project.jpg',title:'Learning by doing',text:'Curiosity grows through active, hands-on learning.'},
{image:'/images/school/12-digital-learning.jpg',title:'Growing skills',text:'Students build confidence through varied learning experiences.'}
];
---
<BaseLayout title="Sarh Al Elm Private School | Muscat" lang="en" description="Discover Sarh Al Elm Private School in Muscat: a welcoming learning community for KG1–Grade 8 with strong academics, bilingual learning and a clear admissions pathway.">
<section class="hero" data-slides={JSON.stringify(heroSlides)}><div class="hero-bg"></div><div class="hero-overlay"></div><div class="wrap hero-content"><div class="hero-copy"><p class="eyebrow">Sarh Al Elm Private School · Muscat</p><h1 id="hero-title">{heroSlides[0]?.headline||'Where curiosity becomes achievement'}</h1><p class="sub" id="hero-sub">{heroSlides[0]?.subhead||'A caring learning community where strong foundations, bilingual learning and confident young minds grow together.'}</p><div class="hero-ctas"><a href="/admissions/" class="btn-primary">Start Your Admission</a><a href="/contact/" class="btn-ghost">Book a School Enquiry</a></div><p class="hero-note">KG1–Grade 8 · Enquiries from prospective families are welcome</p></div></div>{heroSlides.length>1&&<div class="hero-controls" aria-label="Hero slideshow controls">{heroSlides.map((_,i)=><button class={i===0?'active':''} data-slide={i} aria-label={`Show slide ${i+1}`}></button>)}</div>}</section>
<section class="quick-actions"><div class="wrap quick-grid"><a href="/admissions/"><strong>Admissions</strong><span>Learn how to apply →</span></a><a href="/academics/"><strong>Academics</strong><span>Explore learning at Sarh Al Elm →</span></a><a href="/school-life/"><strong>School Life</strong><span>See our community in action →</span></a><a href="/contact/"><strong>Contact Us</strong><span>Speak with our school team →</span></a></div></section>
<section class="block wrap welcome"><div class="principal-photo" role="img" aria-label="School principal" style={p?.principalPhoto?`background-image:url(${p.principalPhoto})`:''}></div><div class="principal-text"><p class="eyebrow-sm">A warm welcome</p><h2>Helping every learner grow with confidence</h2><p class="msg">{p?.principalMessage||'At Sarh Al Elm, we aim to create a safe, purposeful and encouraging school experience where children build knowledge, character, curiosity and confidence.'}</p><a href="/about/" class="text-link">Discover our school →</a></div></section>
<section class="school-story"><div class="wrap story-grid"><div class="story-copy"><p class="eyebrow-sm">Learning in action</p><h2>Real moments from our school community</h2><p>From practical exploration to digital learning, students are encouraged to participate, collaborate and grow in confidence throughout their school experience.</p><a href="/school-life/" class="text-link">Explore school life →</a></div><div class="story-photos">{schoolMoments.map((m,i)=><figure class={i===0?'story-main':'story-side'}><img src={m.image} alt={m.title} loading="lazy"/><figcaption><strong>{m.title}</strong><span>{m.text}</span></figcaption></figure>)}</div></div></section>
<section class="admissions-band"><div class="wrap admissions-inner"><div><p class="eyebrow-light">Admissions</p><h2>Looking for the right school for your child?</h2><p>Start with a simple enquiry. Our team can guide you through the next steps and answer your questions about joining Sarh Al Elm.</p></div><div class="admissions-actions"><a href="/admissions/" class="btn-primary">Begin Admission</a><a href="/contact/" class="btn-outline-light">Ask a Question</a></div></div></section>
<section class="block wrap"><div class="section-head"><div><p class="eyebrow-sm">Stay informed</p><h2>Latest news</h2></div><a href="/news/">View all announcements →</a></div><div class="news-grid">{newsItems.length===0&&<p class="empty">School news and announcements will appear here.</p>}{newsItems.map(post=><a class="news-card" href={`/news/${post.id}/`}><div class="news-thumb" style={`background-image:url(${post.data.coverImage})`}></div><div class="news-body"><div class="news-date">{post.data.date.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}</div><h3>{post.data.title}</h3>{post.data.excerpt&&<p>{post.data.excerpt}</p>}<span>Read more →</span></div></a>)}</div></section>
<section class="gallery-section"><div class="block wrap"><div class="section-head"><div><p class="eyebrow-sm">Our community</p><h2>Life at Sarh Al Elm</h2></div><a href="/gallery/">View full gallery →</a></div><div class="gallery-grid">{galleryPreview.length===0&&<p class="empty">School photographs will appear here.</p>}{galleryPreview.map((g,i)=><a href="/gallery/" class="g-item" aria-label={`View school gallery photo ${i+1}`} style={`background-image:url(${g.image})`}></a>)}</div></div></section>
{testimonials.length>0&&<section class="block wrap testimonials"><div class="section-head"><div><p class="eyebrow-sm">Parent voices</p><h2>What families say</h2></div></div><div class="testimonial-grid">{testimonials.map(t=><div class="testimonial-card"><p class="quote">“{t.data.quote}”</p><p class="name">{t.data.parentName}</p></div>)}</div></section>}
<section class="final-cta"><div class="wrap"><p class="eyebrow-light">Take the next step</p><h2>Come and discover Sarh Al Elm</h2><p>We would be pleased to hear from your family and help you learn more about our school.</p><div class="hero-ctas center"><a href="/admissions/" class="btn-primary">Enquire About Admission</a><a href="/contact/" class="btn-outline-light">Contact the School</a></div></div></section>
</BaseLayout>
<script>const hero=document.querySelector('.hero');if(hero){const slides=JSON.parse(hero.getAttribute('data-slides')||'[]');const bg=hero.querySelector('.hero-bg');const title=document.getElementById('hero-title');const sub=document.getElementById('hero-sub');const dots=[...hero.querySelectorAll('[data-slide]')];let current=0,timer;const show=i=>{if(!slides.length)return;current=i;bg.style.backgroundImage=`url(${slides[i].image})`;title.textContent=slides[i].headline;sub.textContent=slides[i].subhead;dots.forEach((d,n)=>d.classList.toggle('active',n===i))};const start=()=>{if(slides.length>1)timer=setInterval(()=>show((current+1)%slides.length),6000)};dots.forEach(d=>d.addEventListener('click',()=>{clearInterval(timer);show(Number(d.dataset.slide));start()}));show(0);start();}</script>
<style>
.hero{position:relative;min-height:650px;display:flex;align-items:center;overflow:hidden;background:#05386b}.hero-bg{position:absolute;inset:0;background-size:cover;background-position:center;transition:opacity .5s}.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,35,66,.94) 0%,rgba(5,56,107,.78) 44%,rgba(5,56,107,.24) 78%,rgba(5,56,107,.08) 100%)}.hero-content{position:relative;z-index:2;width:100%;color:#fff}.hero-copy{max-width:650px;padding:96px 0}.eyebrow{font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#dbe9f7;margin-bottom:18px}.hero h1{font-family:var(--font-display);font-size:clamp(42px,5vw,66px);line-height:1.05;font-weight:600;max-width:620px;margin-bottom:22px}.hero .sub{font-size:18px;line-height:1.7;color:#eef5fb;max-width:590px;margin-bottom:30px}.hero-ctas{display:flex;gap:12px;flex-wrap:wrap}.hero-note{margin-top:22px;font-size:13px;color:#dbe9f7}.hero-controls{position:absolute;z-index:4;bottom:28px;left:50%;transform:translateX(-50%);display:flex;gap:9px}.hero-controls button{width:28px;height:4px;border:0;border-radius:5px;background:rgba(255,255,255,.4);padding:0;cursor:pointer}.hero-controls button.active{background:#fff}.btn-outline-light{display:inline-block;border:1px solid rgba(255,255,255,.65);color:#fff;padding:12px 24px;border-radius:7px;font-weight:600;font-size:14px;text-decoration:none}.quick-actions{background:#fff;box-shadow:0 8px 30px rgba(14,42,70,.08);position:relative;z-index:3}.quick-grid{display:grid;grid-template-columns:repeat(4,1fr)}.quick-grid a{padding:28px 24px;text-decoration:none;border-right:1px solid #e8edf2}.quick-grid a:last-child{border-right:0}.quick-grid strong{display:block;color:var(--navy-dark);font-family:var(--font-display);font-size:19px;margin-bottom:5px}.quick-grid span{font-size:12.5px;color:var(--slate)}.block{padding-top:84px;padding-bottom:84px}.welcome{display:grid;grid-template-columns:280px 1fr;gap:56px;align-items:center}.principal-photo{width:280px;height:320px;border-radius:18px;background:#d6e1ee center/cover}.eyebrow-sm,.eyebrow-light{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;margin-bottom:10px}.eyebrow-sm{color:var(--gold)}.eyebrow-light{color:#cfe2f5}.principal-text h2,.section-head h2,.admissions-band h2,.final-cta h2,.story-copy h2{font-family:var(--font-display);color:var(--navy-dark);font-size:clamp(28px,3vw,40px);line-height:1.15}.principal-text .msg{font-size:16px;line-height:1.8;color:var(--slate);margin:20px 0;max-width:700px}.text-link,.section-head a{color:var(--navy);font-weight:600;text-decoration:none}.school-story{background:#f3f6f8;padding:84px 0}.story-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:58px;align-items:center}.story-copy p:not(.eyebrow-sm){color:var(--slate);line-height:1.8;margin:18px 0}.story-photos{display:grid;grid-template-columns:1.2fr .8fr;gap:14px}.story-photos figure{margin:0;position:relative;overflow:hidden;border-radius:16px;min-height:390px;box-shadow:0 18px 45px rgba(4,34,62,.12)}.story-photos img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover}.story-photos figcaption{position:absolute;left:14px;right:14px;bottom:14px;padding:13px 14px;border-radius:10px;background:rgba(4,34,62,.86);color:#fff}.story-photos figcaption strong,.story-photos figcaption span{display:block}.story-photos figcaption span{font-size:12px;color:#dbe9f7;margin-top:3px}.admissions-band{background:var(--navy-dark);color:#fff;padding:64px 0}.admissions-inner{display:flex;align-items:center;justify-content:space-between;gap:50px}.admissions-inner>div:first-child{max-width:700px}.admissions-band h2{color:#fff;margin-bottom:14px}.admissions-band p{color:#dbe9f7}.admissions-actions{display:flex;gap:12px;flex-wrap:wrap}.section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:34px}.news-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.news-card{border:1px solid #e7ebef;border-radius:14px;overflow:hidden;text-decoration:none;background:#fff}.news-thumb{height:190px;background:#e8edf2 center/cover}.news-body{padding:22px}.news-date{font-size:12px;color:var(--gold);font-weight:700}.news-body h3{font-size:17px;margin:8px 0}.news-body p{font-size:13.5px;color:var(--slate)}.news-body span{font-size:12.5px;color:var(--navy);font-weight:600}.gallery-section{background:var(--cream)}.gallery-grid{display:grid;grid-template-columns:1.35fr 1fr 1fr;grid-template-rows:180px 180px;gap:12px}.g-item{background:#d6e1ee center/cover;border-radius:12px;min-height:180px}.g-item:first-child{grid-row:span 2}.testimonial-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}.testimonial-card{border:1px solid #e7ebef;border-radius:14px;padding:30px}.quote{line-height:1.75;font-style:italic}.name{font-weight:600;color:var(--navy);margin-top:14px}.final-cta{text-align:center;background:linear-gradient(135deg,#074b8a,#05386b);color:#fff;padding:82px 20px}.final-cta h2{color:#fff}.final-cta>div>p:not(.eyebrow-light){max-width:650px;margin:16px auto 26px;color:#dbe9f7}.center{justify-content:center}.empty{color:var(--slate)}@media(max-width:900px){.hero-overlay{background:rgba(3,35,66,.76)}.quick-grid{grid-template-columns:1fr 1fr}.welcome{grid-template-columns:220px 1fr}.principal-photo{width:220px;height:270px}.story-grid{grid-template-columns:1fr}.admissions-inner{flex-direction:column;align-items:flex-start}.news-grid{grid-template-columns:1fr 1fr}.gallery-grid{grid-template-columns:1fr 1fr;grid-template-rows:auto}.g-item:first-child{grid-row:auto}}@media(max-width:600px){.hero{min-height:560px}.hero-copy{padding:72px 0}.hero h1{font-size:38px}.hero .sub{font-size:16px}.hero-ctas>a{width:100%;text-align:center}.quick-grid,.welcome,.news-grid,.gallery-grid,.testimonial-grid,.story-photos{grid-template-columns:1fr}.quick-grid a{border-right:0;border-bottom:1px solid #e8edf2;padding:20px 18px}.principal-photo{width:100%;height:340px}.block,.school-story{padding-top:58px;padding-bottom:58px}.story-grid{gap:32px}.story-photos figure{min-height:280px}.section-head{align-items:flex-start;flex-direction:column}.g-item{min-height:220px}.admissions-actions{width:100%}.admissions-actions a{width:100%;text-align:center}}
</style>