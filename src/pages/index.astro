---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';

let settings;
try { settings = await getEntry('settings', 'site'); } catch {}
const p = settings?.data;

let testimonials = [];
try {
  testimonials = (await getCollection('testimonials')).sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
} catch {}

let slides = [];
try {
  slides = (await getCollection('hero-slides')).sort((a, b) => a.data.order - b.data.order);
} catch {}

let newsItems = [];
try {
  newsItems = (await getCollection('news'))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 3);
} catch {}

let singles = [];
let albums = [];
try {
  singles = await getCollection('gallery-singles');
  albums = await getCollection('gallery-albums');
} catch {}
const galleryPreview = [...albums.map(a => ({ image: a.data.coverImage })), ...singles.map(s => ({ image: s.data.image }))].slice(0, 5);
---
<BaseLayout title="Sarh Al Elm Private School" lang="en" description="A Cambridge and Oman MOE-aligned private school in Muscat, serving Grades 1–8.">

  <section class="hero">
    <div class="hero-slide"></div>
    <div class="hero-watermark" aria-hidden="true"></div>
    <div class="wrap hero-content">
      <p class="eyebrow">Grades 1–8 · Cambridge &amp; Oman MOE Curriculum</p>
      <h1>Where curiosity becomes achievement</h1>
      <p class="sub">A learning community in Muscat built on strong fundamentals, bilingual excellence, and a love of discovery.</p>
      <div class="hero-ctas">
        <a href="/admissions/" class="btn-primary">Apply for Admission</a>
        <a href="/academics/" class="btn-ghost">Explore Academics</a>
      </div>
    </div>
    {slides.length > 1 && (
      <div class="hero-dots" aria-hidden="true">
        {slides.map((_, i) => <span class={i === 0 ? 'active' : ''}></span>)}
      </div>
    )}
  </section>

  <div class="stats wrap">
    <div class="stat"><div class="icon">👥</div><div class="num">15:1</div><div class="label">Student : teacher ratio</div></div>
    <div class="stat"><div class="icon">🏫</div><div class="num">22</div><div class="label">Average class size</div></div>
    <div class="stat"><div class="icon">🌍</div><div class="num">12+</div><div class="label">Nationalities</div></div>
    <div class="stat"><div class="icon">🎒</div><div class="num">5–13</div><div class="label">Age range (Grades 1–8)</div></div>
  </div>

  <section class="block wrap principal">
    <div class="principal-photo" style={p?.principalPhoto ? `background-image:url(${p.principalPhoto})` : ''}></div>
    <div class="principal-text">
      <p class="eyebrow-sm">Principal's Welcome</p>
      <h2>{p?.principalName || 'Head of School'}</h2>
      <p class="msg">{p?.principalMessage || 'A welcome message from the principal will appear here once added via the CMS.'}</p>
      <a href="/about/" class="read-more">Read full welcome →</a>
    </div>
  </section>

  <div class="quote-band">
    <div class="wrap">
      <blockquote>"Every child who walks through our doors leaves knowing a little more about who they can become."</blockquote>
      <cite>— Head of School, Sarh Al Elm Private School</cite>
    </div>
  </div>

  <section class="block wrap">
    <div class="section-head">
      <h2>Latest news</h2>
      <a href="/news/">View all announcements →</a>
    </div>
    <div class="news-grid">
      {newsItems.length === 0 && <p class="empty">News posts will appear here once published.</p>}
      {newsItems.map((post) => (
        <a class="news-card" href={`/news/${post.id}/`}>
          <div class="news-thumb" style={`background-image:url(${post.data.coverImage})`}></div>
          <div class="news-body">
            <div class="news-date">{post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</div>
            <h3>{post.data.title}</h3>
            {post.data.excerpt && <p>{post.data.excerpt}</p>}
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="block wrap gallery-section">
    <div class="section-head">
      <h2>Life at Sarh Al Elm</h2>
      <a href="/gallery/">View full gallery →</a>
    </div>
    <div class="gallery-grid">
      {galleryPreview.length === 0 && <p class="empty">Photos will appear here once staff add them via the CMS.</p>}
      {galleryPreview.map((g) => (
        <div class="g-item" style={`background-image:url(${g.image})`}></div>
      ))}
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="block wrap testimonials">
      <div class="section-head">
        <h2>What parents say</h2>
      </div>
      <div class="testimonial-grid">
        {testimonials.map((t) => (
          <div class="testimonial-card">
            <p class="quote">"{t.data.quote}"</p>
            <p class="name">{t.data.parentName}</p>
          </div>
        ))}
      </div>
    </section>
  )}

</BaseLayout>

<style>
  .hero { position: relative; height: 560px; overflow: hidden; }
  .hero-slide {
    position: absolute; inset: 0;
    background: linear-gradient(120deg, #0a5aa3 0%, #063e73 55%, #052e57 100%);
  }
  .hero-watermark {
    position: absolute; right: -40px; bottom: -60px; width: 420px; height: 420px;
    border: 2px solid rgba(255,255,255,.08); border-radius: 50%;
  }
  .hero-content {
    position: relative; z-index: 2; height: 100%; max-width: 640px;
    display: flex; flex-direction: column; justify-content: center; color: #fff;
  }
  .eyebrow { font-size: 14px; color: #BFD8F0; margin-bottom: 14px; }
  .hero h1 { font-family: var(--font-display); font-size: 44px; line-height: 1.15; font-weight: 600; margin-bottom: 18px; }
  .hero .sub { font-size: 16px; color: #DCE7F4; margin-bottom: 28px; max-width: 480px; }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-dots {
    position: absolute; bottom: 26px; left: 24px; z-index: 2; display: flex; gap: 8px;
  }
  .hero-dots span { width: 22px; height: 3px; background: rgba(255,255,255,.35); border-radius: 2px; }
  .hero-dots span.active { background: #fff; }

  .stats { display: grid; grid-template-columns: repeat(4,1fr); border-bottom: 1px solid #ECEDEF; }
  .stat { padding: 36px 16px; text-align: center; border-right: 1px solid #ECEDEF; }
  .stat:last-child { border-right: none; }
  .stat .icon { font-size: 26px; margin-bottom: 10px; }
  .stat .num { font-family: var(--font-display); font-size: 30px; font-weight: 600; color: var(--navy); }
  .stat .label { font-size: 13px; color: var(--slate); margin-top: 4px; }

  .principal { display: grid; grid-template-columns: 220px 1fr; gap: 40px; align-items: center; }
  .principal-photo {
    width: 220px; height: 220px; border-radius: 50%;
    background: linear-gradient(135deg,#D6E1EE,#B9CBE0);
    background-size: cover; background-position: center; flex-shrink: 0;
  }
  .eyebrow-sm { font-size: 13px; color: var(--gold); font-weight: 600; margin-bottom: 8px; text-transform: uppercase; letter-spacing: .03em; }
  .principal-text h2 { font-family: var(--font-display); font-size: 24px; color: var(--navy-dark); margin-bottom: 14px; }
  .principal-text .msg { font-size: 15px; line-height: 1.7; color: var(--ink); margin-bottom: 16px; max-width: 620px; }
  .read-more { font-size: 13.5px; font-weight: 600; color: var(--navy); text-decoration: none; }

  .testimonials { background: var(--cream); }
  .testimonial-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 24px; }
  .testimonial-card { background: #fff; border-radius: 10px; padding: 28px; border: 1px solid #ECEDEF; }
  .testimonial-card .quote { font-size: 15px; line-height: 1.7; color: var(--ink); margin-bottom: 14px; font-style: italic; }
  .testimonial-card .name { font-size: 13.5px; font-weight: 600; color: var(--navy); }

  .quote-band { background: var(--cream); padding: 80px 0; text-align: center; }
  .quote-band blockquote {
    font-family: var(--font-display); font-size: 26px; font-weight: 500;
    max-width: 720px; margin: 0 auto 18px; line-height: 1.4; color: var(--navy-dark);
  }
  .quote-band cite { font-size: 13.5px; color: var(--slate); font-style: normal; }

  .block { padding: 72px 24px; }
  .section-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 36px; flex-wrap: wrap; gap: 10px; }
  .section-head h2 { font-family: var(--font-display); font-size: 28px; font-weight: 600; }
  .section-head a { font-size: 13.5px; color: var(--navy); text-decoration: none; font-weight: 600; white-space: nowrap; }

  .news-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
  .news-card { border: 1px solid #ECEDEF; border-radius: 8px; overflow: hidden; text-decoration: none; color: inherit; display: block; }
  .news-thumb { height: 150px; background: linear-gradient(135deg,#E7ECF3,#D6DEE9); background-size: cover; background-position: center; }
  .news-body { padding: 18px; }
  .news-date { font-size: 12px; color: var(--gold); font-weight: 600; margin-bottom: 6px; }
  .news-body h3 { font-size: 15.5px; font-weight: 600; margin-bottom: 6px; line-height: 1.35; }
  .news-body p { font-size: 13.5px; color: var(--slate); line-height: 1.5; }

  .gallery-section { background: var(--cream); }
  .gallery-grid {
    display: grid; grid-template-columns: 1.4fr 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 12px; height: 340px;
  }
  .g-item {
    background: linear-gradient(135deg,#D6E1EE,#B9CBE0);
    background-size: cover; background-position: center;
    border-radius: 8px;
  }
  .g-item:first-child { grid-row: span 2; }

  .empty { color: var(--slate); font-size: 14px; grid-column: 1 / -1; }

  @media (max-width: 900px) {
    .news-grid { grid-template-columns: 1fr 1fr; }
    .gallery-grid { grid-template-columns: 1fr 1fr; grid-template-rows: repeat(3,1fr); height: auto; }
    .g-item { min-height: 140px; }
    .g-item:first-child { grid-row: span 1; }
    .principal { grid-template-columns: 1fr; text-align: center; }
    .principal-photo { margin: 0 auto; }
    .testimonial-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .hero { height: auto; padding: 60px 0; }
    .hero h1 { font-size: 32px; }
    .news-grid { grid-template-columns: 1fr; }
    .gallery-grid { grid-template-columns: 1fr; }
    .stats { grid-template-columns: 1fr 1fr; }
  }
</style>
