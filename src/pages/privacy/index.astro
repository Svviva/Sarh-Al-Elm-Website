---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy Policy — Sarh Al Elm Private School" lang="en">
  <section class="block wrap">
    <h1>Privacy Policy &amp; PDPL Compliance</h1>
    <p>Sarh Al Elm Private School is committed to protecting the privacy of visitors to this website in line with Oman's Personal Data Protection Law (PDPL). This website does not require visitors to create an account or submit personal data to browse its content.</p>
    <p>Full policy text to be added by the school administration.</p>
  </section>
</BaseLayout>

<style>
  .block { padding: 64px 24px; max-width: 720px; }
  h1 { font-family: var(--font-display); font-size: 30px; margin-bottom: 24px; color: var(--navy-dark); }
  p { font-size: 15px; line-height: 1.7; margin-bottom: 14px; color: var(--ink); }
</style>
