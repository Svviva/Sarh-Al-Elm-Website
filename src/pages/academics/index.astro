---
import BaseLayout from '../../layouts/BaseLayout.astro';

const subjects = [
  'English Language & Literature', 'Arabic Language', 'Mathematics', 'Science',
  'Islamic Studies', 'Social Studies', 'ICT & Computing', 'Art & Design',
  'Physical Education', 'Music', 'Life Skills',
];
---
<BaseLayout title="Academics — Sarh Al Elm Private School" lang="en">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Academics</p>
      <h1>Grades 1 through 8, one continuous journey</h1>
      <p class="sub">A curriculum that blends Cambridge's inquiry-based learning with the structure of the Oman Ministry of Education framework.</p>
    </div>
  </section>

  <section class="block wrap">
    <h2>Subjects offered</h2>
    <div class="subject-grid">
      {subjects.map((s) => <div class="subject-card">{s}</div>)}
    </div>
  </section>

  <section class="block wrap grades">
    <h2>Grade levels</h2>
    <div class="grade-list">
      <div class="grade-band">
        <h3>Grades 1–3</h3>
        <p>Foundation years focused on literacy, numeracy, and building strong learning habits.</p>
      </div>
      <div class="grade-band">
        <h3>Grades 4–6</h3>
        <p>Broader subject exposure with growing independence and project-based learning.</p>
      </div>
      <div class="grade-band">
        <h3>Grades 7–8</h3>
        <p>Deeper subject specialization, preparing students for the transition to secondary study.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background: var(--navy); color: #fff; padding: 64px 0; }
  .page-hero .eyebrow { color: #BFD8F0; font-size: 14px; margin-bottom: 12px; }
  .page-hero h1 { font-family: var(--font-display); font-size: 36px; font-weight: 600; margin-bottom: 14px; max-width: 640px; }
  .page-hero .sub { color: #DCE7F4; max-width: 560px; font-size: 15.5px; }
  .block { padding: 64px 24px; }
  h2 { font-family: var(--font-display); font-size: 24px; margin-bottom: 24px; color: var(--navy-dark); }
  .subject-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; }
  .subject-card {
    border: 1px solid #ECEDEF; border-radius: 8px; padding: 18px; font-size: 14.5px; font-weight: 500;
  }
  .grades { background: var(--cream); }
  .grade-list { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }
  .grade-band { background: #fff; border-radius: 8px; padding: 24px; border: 1px solid #ECEDEF; }
  .grade-band h3 { font-family: var(--font-display); color: var(--navy); font-size: 18px; margin-bottom: 10px; }
  .grade-band p { font-size: 14px; color: var(--slate); line-height: 1.6; }
  @media (max-width: 800px) {
    .subject-grid { grid-template-columns: 1fr 1fr; }
    .grade-list { grid-template-columns: 1fr; }
  }
</style>
