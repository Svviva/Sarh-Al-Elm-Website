---
import BaseLayout from '../../layouts/BaseLayout.astro';
const needs=[['Subjects by grade','Confirmed subject list for KG1–Grade 8, teaching language for each subject, weekly lesson allocation and any electives.'],['Assessment','How students are assessed; report frequency; examinations; continuous assessment; grading scale; promotion/progression policy.'],['Learning support','Support available for students who need additional academic, language or inclusion assistance, and how families access it.'],['Homework & parent reporting','Homework expectations by age, parent communication, reporting schedule and parent-teacher meeting arrangements.'],['Academic calendar & school day','Term dates, school hours, lesson length, break times and any differences by grade.']];
---
<BaseLayout title="Academics | Sarh Al Elm Private School, Muscat" lang="en" description="Explore the academic journey for KG1–Grade 8 at Sarh Al Elm Private School in Muscat, including Mathematics and Science taught through the Oman Ministry of Education curriculum and resources developed with Cambridge.">
<section class="hero"><div class="wrap"><p>Academics · KG1–Grade 8</p><h1>A clear learning journey, from strong foundations to growing independence</h1><span>Sarh Al Elm supports students through KG1–Grade 8 in a bilingual school environment, with learning guided by the educational requirements of the Sultanate of Oman.</span></div></section>
<section class="intro wrap"><div><p class="kicker">Our academic approach</p><h2>Learning with purpose, confidence and curiosity</h2></div><p>Our aim is to help students build secure foundations, communicate effectively, develop independence and participate actively in learning. We provide families with clear information about the learning their children experience at school.</p></section>
<section class="learning-photos wrap" aria-label="Learning at Sarh Al Elm"><figure><img src="/images/school/02-student-learning.jpg" alt="Students learning together at Sarh Al Elm" loading="lazy"/><figcaption>Learning through participation and discovery</figcaption></figure><figure><img src="/images/school/12-digital-learning.jpg" alt="Students engaged in digital learning at Sarh Al Elm" loading="lazy"/><figcaption>Building confidence with digital learning</figcaption></figure></section>
<section class="cambridge"><div class="wrap cambridge-grid"><div><p class="kicker">Mathematics & Science</p><h2>International approaches, adapted for Oman</h2></div><div><p>Sarh Al Elm teaches the Oman Ministry of Education Mathematics and Science curriculum and learning resources developed through the Ministry’s partnership with Cambridge University Press & Assessment.</p><p>The national programme combines international approaches to Mathematics and Science education with the Omani context, culture and values. The curriculum and learning resources are designed to strengthen knowledge while encouraging skills such as problem-solving, critical thinking, scientific inquiry and active learning.</p></div></div></section>
<section class="journey"><div class="wrap"><p class="kicker">The learning journey</p><h2>Progress through KG1–Grade 8</h2><div class="bands"><article><h3>Kindergarten 1 & 2</h3><p>An encouraging early-years stage that helps children build foundational skills and readiness for school learning.</p></article><article><h3>Grades 1–3</h3><p>Building strong foundations in literacy, numeracy, communication and positive learning habits.</p></article><article><h3>Grades 4–6</h3><p>Developing knowledge across subjects while encouraging greater independence, collaboration and confident thinking.</p></article><article><h3>Grades 7–8</h3><p>Deepening subject knowledge and strengthening the study skills students need for their next stage of education.</p></article></div></div></section>
<section class="principles wrap"><p class="kicker">What guides learning</p><h2>A balanced school experience</h2><div class="principle-grid"><article><h3>Strong foundations</h3><p>Core knowledge and skills are developed progressively as students move through the school.</p></article><article><h3>Bilingual learning</h3><p>Language and communication are important parts of the school experience and students' wider development.</p></article><article><h3>Active participation</h3><p>Students are encouraged to ask questions, communicate ideas, practise skills and take increasing responsibility for learning.</p></article><article><h3>Growth & wellbeing</h3><p>Academic progress is supported by a respectful environment where students can develop confidence and a sense of belonging.</p></article></div></section>
<section class="admin"><div class="wrap admin-grid"><div><p class="kicker">More information</p><h2>Ask us about your child's learning</h2><p>For current details about subjects, assessment, learning support, homework, reporting, the school calendar or the school day, families are welcome to contact the school directly.</p></div><div class="needs">{needs.map(([title,body])=><details><summary>{title}</summary><p>{body}</p></details>)}</div></div></section>
<section class="cta"><div class="wrap"><h2>Have a question about your child's grade?</h2><p>Families are welcome to contact the school directly for current academic information.</p><a class="btn-primary" href="/contact/">Ask the school</a></div></section>
</BaseLayout>
<style>.hero{background:linear-gradient(90deg,rgba(4,34,62,.94),rgba(4,34,62,.56)),url('/images/school/04-student-project.jpg') center 46%/cover;color:#fff;padding:96px 0}.hero>div>p,.kicker{font-size:12px;text-transform:uppercase;letter-spacing:.1em;font-weight:700;color:#d5a43f}.hero h1{font-family:var(--font-display);font-size:clamp(38px,5vw,56px);line-height:1.08;max-width:850px;margin:10px 0 18px}.hero span{display:block;max-width:720px;color:#eef5fb;font-size:17px;line-height:1.7}.intro{display:grid;grid-template-columns:1fr 1fr;gap:70px;padding-top:75px;padding-bottom:45px}.intro h2,.cambridge h2,.journey h2,.principles h2,.admin h2,.cta h2{font-family:var(--font-display);font-size:clamp(28px,3vw,38px);line-height:1.18;color:var(--navy-dark);margin-top:8px}.intro>p{color:var(--slate);line-height:1.8}.learning-photos{display:grid;grid-template-columns:1.15fr .85fr;gap:18px;padding-bottom:70px}.learning-photos figure{margin:0;position:relative;overflow:hidden;border-radius:14px;min-height:300px;background:#eef3f7}.learning-photos img{width:100%;height:100%;min-height:300px;object-fit:cover;display:block}.learning-photos figcaption{position:absolute;left:16px;bottom:16px;background:rgba(4,34,62,.88);color:#fff;padding:9px 13px;border-radius:8px;font-size:13px}.cambridge{background:#eef3f7;padding:70px 0}.cambridge-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:70px}.cambridge-grid>div:last-child>p{color:var(--slate);line-height:1.8;margin-bottom:16px}.journey{background:var(--cream);padding:70px 0}.bands{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:30px}.bands article,.principle-grid article{background:#fff;border:1px solid #e5e9ed;border-radius:12px;padding:28px}.bands h3,.principle-grid h3{font-family:var(--font-display);color:var(--navy-dark);font-size:21px;margin:9px 0}.bands p,.principle-grid p,.admin p{color:var(--slate);font-size:14px;line-height:1.7}.principles{padding-top:75px;padding-bottom:75px}.principle-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:28px}.admin{background:#eef3f7;padding:72px 0}.admin-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px}.needs{border-top:1px solid #ccd6df}details{border-bottom:1px solid #ccd6df}summary{cursor:pointer;font-weight:700;padding:18px 32px 18px 0;position:relative}summary:after{content:'+';position:absolute;right:4px;color:var(--navy);font-size:20px}details[open] summary:after{content:'–'}details p{padding:0 32px 18px 0}.cta{text-align:center;padding:70px 0}.cta p{color:var(--slate);margin:12px auto 24px;max-width:620px}@media(max-width:750px){.hero{padding:70px 0;background-position:center}.intro,.admin-grid,.learning-photos,.cambridge-grid{grid-template-columns:1fr;gap:28px}.bands,.principle-grid{grid-template-columns:1fr}.intro,.principles{padding-top:55px;padding-bottom:35px}.journey,.admin,.cambridge{padding:55px 0}}</style>