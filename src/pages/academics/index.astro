---
import BaseLayout from '../../layouts/BaseLayout.astro';
const needs=[['Subjects by grade','Confirmed subject list for KG1–Grade 8, teaching language for each subject, weekly lesson allocation and any electives.'],['Assessment','How students are assessed; report frequency; examinations; continuous assessment; grading scale; promotion/progression policy.'],['Learning support','Support available for students who need additional academic, language or inclusion assistance, and how families access it.'],['Homework & parent reporting','Homework expectations by age, parent communication, reporting schedule and parent-teacher meeting arrangements.'],['Academic calendar & school day','Term dates, school hours, lesson length, break times and any differences by grade.']];
---
<BaseLayout title="Academics | Sarh Al Elm Private School, Muscat" lang="en" description="Explore the academic journey for KG1–Grade 8 at Sarh Al Elm Private School in Muscat, including Mathematics and Science taught through the Oman Ministry of Education curriculum and resources developed with Cambridge.">
<section class="hero"><div class="wrap"><p>Academics · KG1–Grade 8</p><h1>A clear learning journey, from strong foundations to growing independence</h1><span>Sarh Al Elm supports students through KG1–Grade 8 in a bilingual school environment, with learning guided by the educational requirements of the Sultanate of Oman.</span></div></section>
<section class="intro wrap"><div><p class="kicker">Our academic approach</p><h2>Learning with purpose, confidence and curiosity</h2></div><p>Our aim is to help students build secure foundations, communicate effectively, develop independence and participate actively in learning. We provide families with clear information about the learning their children experience at school.</p></section>
<section class="learning-photos wrap" aria-label="Learning at Sarh Al Elm"><figure><img src="/images/school/02-student-learning.jpg" alt="Students learning together at Sarh Al Elm" loading="lazy"/><figcaption>Learning through participation and discovery</figcaption></figure><figure><img src="/images/school/12-digital-learning.jpg" alt="Students engaged in digital learning at Sarh Al Elm" loading="lazy"/><figcaption>Building confidence with digital learning</figcaption></figure></section>
<section class="cambridge"><div class="wrap cambridge-grid"><div><p class="kicker">Mathematics & Science</p><h2>International approaches, adapted for Oman</h2></div><div><p>Sarh Al Elm teaches the Oman Ministry of Education Mathematics and Science curriculum and learning resources developed through the Ministry’s partnership with Cambridge University Press & Assessment.</p><p>The national programme combines international approaches to Mathematics and Science education with the Omani context, culture and values. The curriculum and learning resources are designed to strengthen knowledge while encouraging skills such as problem-solving, critical thinking, scientific inquiry and active learning.</p></div></div></section>
<section class="journey"><div class="wrap"><p class="kicker">Programmes & stages</p><h2>From Kindergarten through Grade 8</h2><div class="program-grid">
<article><div class="program-head"><span>Early Years</span><h3>Kindergarten 1 & 2</h3><p class="time">School day: 7:30 AM – 12:00 PM</p></div><div class="program-body"><h4>Curricula offered</h4><ul><li>Enrichment books: Nour Al-Bayan and Fath Al-Rahman</li><li>English Language</li><li>Arabic Language and Mathematics (Knowledge Orchards)</li><li>Islamic Education (Omani Curriculum)</li><li>Holy Quran memorization</li></ul><h4>Age group</h4><p>Kindergarten I: from 3½ years<br/>Kindergarten II: from 4½ years</p><h4>Facilities</h4><p>Colorful classrooms, activity and play area, reading/story corner, creative arts & craft zone, audio-visual room, smart boards and digital learning tools, dining/snack area, sensory play area, and security & CCTV surveillance.</p></div></article>
<article><div class="program-head"><span>Level 1</span><h3>Grades 1–4</h3><p class="time">School day: 7:00 AM – 1:30 PM</p></div><div class="program-body"><h4>Bilingual curriculum</h4><ul><li>Arabic Language</li><li>Islamic Education</li><li>Mathematics, Science and English (Cambridge Curriculum)</li><li>Individual skills: Identity & Citizenship, Visual Arts, Sports, Music and Information Technology</li></ul><h4>Facilities</h4><p>Learning resources, physical exercise arena and library.</p></div></article>
<article><div class="program-head"><span>Level 2</span><h3>Grades 5–8</h3><p class="time">School day: 7:00 AM – 1:30 PM</p></div><div class="program-body"><h4>Bilingual curriculum</h4><ul><li>Arabic Language</li><li>Islamic Education</li><li>Mathematics, Science and English (Cambridge Curriculum)</li><li>Individual skills: Identity & Citizenship, Visual Arts, Sports, Music and Information Technology</li></ul><h4>Facilities</h4><p>Learning resources, physical exercise arena, library and science laboratory.</p></div></article>
</div></div></section>
<section class="principles wrap"><p class="kicker">What guides learning</p><h2>A balanced school experience</h2><div class="principle-grid"><article><h3>Strong foundations</h3><p>Core knowledge and skills are developed progressively as students move through the school.</p></article><article><h3>Bilingual learning</h3><p>Language and communication are important parts of the school experience and students' wider development.</p></article><article><h3>Active participation</h3><p>Students are encouraged to ask questions, communicate ideas, practise skills and take increasing responsibility for learning.</p></article><article><h3>Growth & wellbeing</h3><p>Academic progress is supported by a respectful environment where students can develop confidence and a sense of belonging.</p></article></div></section>
<section class="cta"><div class="wrap"><h2>Have a question about your child's grade?</h2><p>Families are welcome to contact the school directly for current academic information.</p><a class="btn-primary" href="/contact/">Ask the school</a></div></section>
</BaseLayout>
<style>.hero{background:linear-gradient(90deg,rgba(4,34,62,.94),rgba(4,34,62,.56)),url('/images/school/04-student-project.jpg') center 46%/cover;color:#fff;padding:96px 0}.hero>div>p,.kicker{font-size:12px;text-transform:uppercase;letter-spacing:.1em;font-weight:700;color:#d5a43f}.hero h1{font-family:var(--font-display);font-size:clamp(38px,5vw,56px);line-height:1.08;max-width:850px;margin:10px 0 18px}.hero span{display:block;max-width:720px;color:#eef5fb;font-size:17px;line-height:1.7}.intro{display:grid;grid-template-columns:1fr 1fr;gap:70px;padding-top:75px;padding-bottom:45px}.intro h2,.cambridge h2,.journey h2,.principles h2,.admin h2,.cta h2{font-family:var(--font-display);font-size:clamp(28px,3vw,38px);line-height:1.18;color:var(--navy-dark);margin-top:8px}.intro>p{color:var(--slate);line-height:1.8}.learning-photos{display:grid;grid-template-columns:1.15fr .85fr;gap:18px;padding-bottom:70px}.learning-photos figure{margin:0;position:relative;overflow:hidden;border-radius:14px;min-height:300px;background:#eef3f7}.learning-photos img{width:100%;height:100%;min-height:300px;object-fit:cover;display:block}.learning-photos figcaption{position:absolute;left:16px;bottom:16px;background:rgba(4,34,62,.88);color:#fff;padding:9px 13px;border-radius:8px;font-size:13px}.cambridge{background:#eef3f7;padding:70px 0}.cambridge-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:70px}.cambridge-grid>div:last-child>p{color:var(--slate);line-height:1.8;margin-bottom:16px}.journey{background:var(--cream);padding:70px 0}.program-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:32px}.program-grid article{background:#fff;border:1px solid #e2e8ed;border-radius:15px;overflow:hidden;box-shadow:0 8px 26px rgba(14,42,70,.05)}.program-head{background:var(--navy-dark);color:#fff;padding:25px}.program-head>span{font-size:11px;text-transform:uppercase;letter-spacing:.09em;color:#d5a43f;font-weight:700}.program-head h3{color:#fff;font-size:23px;margin:7px 0}.program-head .time{color:#dbe9f7;margin:0;font-size:13px}.program-body{padding:25px}.program-body h4{color:var(--navy-dark);margin:0 0 9px;font-size:15px}.program-body h4:not(:first-child){margin-top:22px}.program-body p,.program-body li{color:var(--slate);font-size:13.5px;line-height:1.7}.program-body ul{padding-inline-start:19px;margin:0}.bands{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:30px}.bands article,.principle-grid article{background:#fff;border:1px solid #e5e9ed;border-radius:12px;padding:28px}.bands h3,.principle-grid h3{font-family:var(--font-display);color:var(--navy-dark);font-size:21px;margin:9px 0}.bands p,.principle-grid p,.admin p{color:var(--slate);font-size:14px;line-height:1.7}.principles{padding-top:75px;padding-bottom:75px}.principle-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:28px}.admin{background:#eef3f7;padding:72px 0}.admin-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px}.needs{border-top:1px solid #ccd6df}details{border-bottom:1px solid #ccd6df}summary{cursor:pointer;font-weight:700;padding:18px 32px 18px 0;position:relative}summary:after{content:'+';position:absolute;right:4px;color:var(--navy);font-size:20px}details[open] summary:after{content:'–'}details p{padding:0 32px 18px 0}.cta{text-align:center;padding:70px 0}.cta p{color:var(--slate);margin:12px auto 24px;max-width:620px}@media(max-width:950px){.program-grid{grid-template-columns:1fr}.program-grid article{display:grid;grid-template-columns:.38fr .62fr}}@media(max-width:750px){.hero{padding:70px 0;background-position:center}.intro,.admin-grid,.learning-photos,.cambridge-grid{grid-template-columns:1fr;gap:28px}.bands,.principle-grid{grid-template-columns:1fr}.program-grid article{display:block}.intro,.principles{padding-top:55px;padding-bottom:35px}.journey,.admin,.cambridge{padding:55px 0}}</style>