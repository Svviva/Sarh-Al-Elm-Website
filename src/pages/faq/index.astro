---
import BaseLayout from '../../layouts/BaseLayout.astro';
const faqs=[['Which grades does Sarh Al Elm serve?','The website currently presents Sarh Al Elm Private School as serving Grades 1–8. Please contact the school for current seat availability in a particular grade.'],['How do I enquire about admission?','Use the admission enquiry form on this website, call the school, email the admissions team, or contact the school through WhatsApp.'],['What documents are required for admission?','Requirements can vary. The admissions office will confirm the current documents needed for your child and grade before you complete enrolment.'],['Does my child need an assessment?','Where an assessment or meeting is required, the school will explain the process and arrange it directly with the family.'],['How can I ask about fees?','Please contact the school directly for the current approved fee information and any applicable payment arrangements.'],['Where is the school located?','Sarh Al Elm Private School is in Muscat, Oman. Contact the school if you need directions or location details.'],['How can I contact the school quickly?','You can use the phone number, email address or WhatsApp link shown on the Contact page.']];
---
<BaseLayout title="Frequently Asked Questions | Sarh Al Elm Private School" lang="en" description="Answers to common parent questions about admissions, grades, fees, contact and school life at Sarh Al Elm Private School in Muscat."><section class="hero"><div class="wrap"><p>Parent information</p><h1>Frequently asked questions</h1><span>Quick answers to common questions from families considering Sarh Al Elm.</span></div></section><section class="wrap faq"><div class="intro"><p>Can't find your answer?</p><h2>Our school team is ready to help.</h2><a href="/contact/">Contact the school →</a></div><div class="questions">{faqs.map(([q,a],i)=><details open={i===0}><summary>{q}</summary><p>{a}</p></details>)}</div></section><section class="admit"><div class="wrap"><h2>Ready to ask about a place for your child?</h2><a class="btn-primary" href="/admissions/#enquiry">Start an admission enquiry</a></div></section></BaseLayout>
<style>
.hero{background:var(--navy-dark);color:#fff;padding:76px 0}.hero p{color:#d5a43f;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.1em}.hero h1{font-family:var(--font-display);font-size:clamp(36px,5vw,52px);margin:8px 0}.hero span{color:#dce7f4}.faq{display:grid;grid-template-columns:.65fr 1.35fr;gap:70px;padding-top:75px;padding-bottom:80px}.intro>p{color:var(--gold);font-size:12px;font-weight:700;text-transform:uppercase}.intro h2{font-family:var(--font-display);color:var(--navy-dark);font-size:28px;margin:8px 0 18px}.intro a{color:var(--navy);font-weight:700;text-decoration:none}.questions{border-top:1px solid #dfe5ea}details{border-bottom:1px solid #dfe5ea;padding:0 4px}summary{cursor:pointer;list-style:none;padding:22px 35px 22px 0;font-weight:700;position:relative}summary::-webkit-details-marker{display:none}summary:after{content:'+';position:absolute;right:4px;color:var(--navy);font-size:22px;top:17px}details[open] summary:after{content:'–'}details p{color:var(--slate);padding:0 35px 22px 0;font-size:14px}.admit{background:#eef3f7;text-align:center;padding:65px 0}.admit h2{font-family:var(--font-display);color:var(--navy-dark);font-size:30px;margin-bottom:20px}.admit .btn-primary{background:var(--navy);color:#fff}@media(max-width:720px){.hero{padding:58px 0}.faq{grid-template-columns:1fr;gap:35px;padding-top:52px;padding-bottom:55px}}
</style>