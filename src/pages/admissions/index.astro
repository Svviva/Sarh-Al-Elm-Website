---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
let settings; try { settings = await getEntry('settings','site'); } catch {}
const data=settings?.data; const email=data?.email||'sarhalilm-mawalih@moe.om'; const phone=data?.phone||'+96897817830'; const wa=data?.whatsappNumber||'96897817830';
const steps=[{title:'Send an admission enquiry',body:'Tell us your child’s grade and your preferred contact details. Our school team can then guide you on availability and next steps.'},{title:'Prepare the requested documents',body:'The admissions office will confirm the documents required for your child and grade before enrolment.'},{title:'School review and assessment',body:'Where required, the school will arrange an age-appropriate review, assessment or family meeting.'},{title:'Complete enrolment',body:'After acceptance, the admissions team will guide you through the remaining registration and enrolment requirements.'}];
---
<BaseLayout title="Admissions | Sarh Al Elm Private School, Muscat" lang="en" description="Enquire about admission to Sarh Al Elm Private School in Muscat for Grades 1–8. Contact our admissions team by form, phone, email or WhatsApp.">
<section class="page-hero"><div class="wrap"><p class="eyebrow">Admissions · Grades 1–8</p><h1>Begin your child’s journey at Sarh Al Elm</h1><p>We want the admissions process to be clear and welcoming. Send an enquiry and our school team will guide you through the appropriate next steps.</p><div class="hero-actions"><a class="btn-primary" href="#enquiry">Start an enquiry</a><a class="btn-ghost" href={`https://wa.me/${wa}?text=${encodeURIComponent('Hello Sarh Al Elm Private School. I would like information about admissions.')}`} target="_blank" rel="noopener">WhatsApp admissions</a></div></div></section>
<section class="block wrap intro-grid"><div><p class="kicker">How it works</p><h2>A simple admissions process</h2><div class="steps">{steps.map((s,i)=><div class="step"><span>{i+1}</span><div><h3>{s.title}</h3><p>{s.body}</p></div></div>)}</div></div><aside class="contact-card"><h2>Admissions contact</h2><p>Have a question before completing the form? Contact the school directly.</p><a href={`tel:${phone}`}>☎ {phone}</a><a href={`mailto:${email}`}>✉ {email}</a><a class="wa" href={`https://wa.me/${wa}?text=${encodeURIComponent('Hello Sarh Al Elm Private School. I have an admissions question.')}`} target="_blank" rel="noopener">Message us on WhatsApp</a><small>Please confirm current fees, seat availability, required documents and assessment arrangements directly with the school.</small></aside></section>
<section id="enquiry" class="form-band"><div class="wrap form-grid"><div><p class="kicker">Admission enquiry</p><h2>Tell us about your child</h2><p>Complete this short form and the school can follow up using the contact details you provide.</p></div><form name="admission-enquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="admission-enquiry"/><p class="hidden"><label>Do not fill this out: <input name="bot-field"/></label></p><div class="fields"><label>Parent / guardian name<input name="parent-name" required autocomplete="name"/></label><label>Phone number<input name="phone" type="tel" required autocomplete="tel"/></label><label>Email address<input name="email" type="email" autocomplete="email"/></label><label>Child’s current / intended grade<select name="grade" required><option value="">Select grade</option>{Array.from({length:8},(_,i)=><option value={`Grade ${i+1}`}>Grade {i+1}</option>)}</select></label><label class="full">Your message<textarea name="message" rows="5" placeholder="Tell us anything that will help the admissions team respond."></textarea></label></div><button type="submit">Send admission enquiry</button><p class="privacy">By submitting this form, you are asking the school to contact you about admissions.</p></form></div></section>
</BaseLayout>
<style>
.page-hero{background:linear-gradient(120deg,#063e73,#07589e);color:#fff;padding:88px 0}.page-hero .eyebrow,.kicker{font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#d5a43f;margin-bottom:10px}.page-hero h1{font-family:var(--font-display);font-size:clamp(36px,5vw,55px);line-height:1.08;max-width:760px;margin-bottom:18px}.page-hero p{max-width:680px;color:#e5eef7;font-size:17px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.block{padding-top:78px;padding-bottom:78px}.intro-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(280px,.7fr);gap:70px}.intro-grid h2,.form-band h2{font-family:var(--font-display);font-size:32px;color:var(--navy-dark);margin-bottom:28px}.steps{display:grid;gap:24px}.step{display:flex;gap:18px}.step span{display:grid;place-items:center;width:38px;height:38px;flex:0 0 38px;border-radius:50%;background:var(--navy);color:#fff;font-weight:700}.step h3{font-size:16px;margin-bottom:5px}.step p{color:var(--slate);font-size:14px}.contact-card{background:var(--cream);border:1px solid #e5e9ee;border-radius:14px;padding:30px;height:max-content}.contact-card h2{font-size:24px;margin-bottom:10px}.contact-card p{color:var(--slate);margin-bottom:20px}.contact-card a{display:block;color:var(--navy);font-weight:700;text-decoration:none;margin:12px 0;overflow-wrap:anywhere}.contact-card .wa{background:#fff;border:1px solid #dfe5ea;padding:12px 14px;border-radius:8px;margin-top:20px}.contact-card small{display:block;color:var(--slate);margin-top:22px;line-height:1.6}.form-band{background:var(--cream);padding:80px 0}.form-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:60px}.form-grid>div>p:last-child{color:var(--slate);max-width:420px}form{background:#fff;padding:30px;border-radius:14px;border:1px solid #e2e7ec}.fields{display:grid;grid-template-columns:1fr 1fr;gap:18px}label{font-size:13px;font-weight:700;color:#344150}input,select,textarea{width:100%;margin-top:7px;padding:12px 13px;border:1px solid #ccd4dc;border-radius:7px;background:#fff;font:inherit;color:var(--ink)}textarea{resize:vertical}.full{grid-column:1/-1}button{border:0;background:var(--navy);color:#fff;font:inherit;font-weight:700;padding:13px 20px;border-radius:7px;cursor:pointer;margin-top:20px}.privacy{font-size:12px;color:var(--slate);margin-top:12px}.hidden{position:absolute;left:-9999px}@media(max-width:800px){.page-hero{padding:66px 0}.intro-grid,.form-grid{grid-template-columns:1fr;gap:38px}.block,.form-band{padding-top:58px;padding-bottom:58px}.fields{grid-template-columns:1fr}.full{grid-column:auto}form{padding:22px}}
</style>