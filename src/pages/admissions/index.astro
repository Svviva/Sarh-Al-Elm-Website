---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
let settings; try { settings = await getEntry('settings','site'); } catch {}
const data=settings?.data; const email=data?.email||'sarhalilm-mawalih@moe.om'; const phone=data?.phone||'+96897817830'; const wa=data?.whatsappNumber||'96897817830';
---
<BaseLayout title="Admissions | Sarh Al Elm Private School, Muscat" lang="en" description="Admissions and registration information for KG1–Grade 8 at Sarh Al Elm Private School in Muscat.">
<section class="page-hero"><div class="wrap"><p class="eyebrow">Admissions · KG1–Grade 8</p><h1>Begin your child’s journey at Sarh Al Elm</h1><p>We are pleased to assist families interested in joining our school. For the latest admissions requirements and guidance, please contact Sarh Al Elm Private School directly.</p><div class="hero-actions"><a class="btn-primary" href={`https://wa.me/${wa}?text=${encodeURIComponent('Hello Sarh Al Elm Private School. I would like information about admissions.')}`} target="_blank" rel="noopener">Ask on WhatsApp</a></div></div></section>
<section class="block wrap intro-grid"><div><p class="kicker">Admissions information</p><h2>Registration information for families</h2><p class="lead">Families can review the registration steps and required documents below. For current school fees, please contact Sarh Al Elm Private School directly so the admissions team can provide the applicable fee information.</p></div><aside class="contact-card"><h2>Admissions contact</h2><p>For current admissions information, message the school directly on WhatsApp.</p><a href={`tel:${phone}`}>☎ {phone}</a><a href={`mailto:${email}`}>✉ {email}</a><a class="wa" href={`https://wa.me/${wa}?text=${encodeURIComponent('Hello Sarh Al Elm Private School. I have an admissions question about: ')}`} target="_blank" rel="noopener">Message admissions on WhatsApp</a><small>For current tuition and registration fee amounts, please contact the school directly.</small></aside></section>
<section class="registration"><div class="wrap"><div class="reg-head"><p class="kicker">In-person registration</p><h2>How to register</h2><p>Sarh Al Elm Private School is pleased to welcome parents and guardians to register their children at the school premises.</p></div><div class="reg-grid"><article class="visit"><span class="step">1</span><h3>Visit the school</h3><p>Please visit the school premises during the registration working hours:</p><div class="hours"><strong>Morning</strong><span>8:00 AM – 12:00 PM</span><strong>Evening</strong><span>4:00 PM – 7:00 PM</span></div></article><article class="docs"><span class="step">2</span><h3>Bring the required documents</h3><ul><li>A copy of the birth certificate, with the original presented for verification.</li><li>A copy of the father’s passport and ID card.</li><li>A copy of the student’s medical immunization record.</li><li>Four passport-size photographs.</li><li>For non-Omani families: a copy of the student’s and father’s visas.</li></ul></article><article class="fee"><span class="step">3</span><h3>Registration fee</h3><p>Pay the registration fee applicable at the time of registration. The registration fee is <strong>non-refundable</strong> and is counted as part of the tuition fees.</p><p class="note">Please contact the school directly for the current registration and tuition fee amounts.</p></article></div></div></section><section class="whatsapp-band"><div class="wrap whatsapp-box"><div><p class="kicker">Admission enquiries</p><h2>Have a question about joining Sarh Al Elm?</h2><p>Parents and guardians can send their admissions questions directly to the school through WhatsApp.</p></div><a class="wa-large" href={`https://wa.me/${wa}?text=${encodeURIComponent('Hello Sarh Al Elm Private School. I would like to ask about admissions: ')}`} target="_blank" rel="noopener">Contact us on WhatsApp</a></div></section>
</BaseLayout>
<style>.page-hero{background:linear-gradient(90deg,rgba(4,34,62,.94),rgba(4,34,62,.58)),url('/images/school/07-creative-activity.jpg') center 45%/cover;color:#fff;padding:96px 0}.page-hero .eyebrow,.kicker{font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#d5a43f;margin-bottom:10px}.page-hero h1{font-family:var(--font-display);font-size:clamp(36px,5vw,55px);line-height:1.08;max-width:760px;margin-bottom:18px}.page-hero p{max-width:680px;color:#eef5fb;font-size:17px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.block{padding-top:78px;padding-bottom:78px}.intro-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(280px,.7fr);gap:70px}.intro-grid h2,.whatsapp-band h2{font-family:var(--font-display);font-size:32px;color:var(--navy-dark);margin-bottom:28px}.lead{color:var(--slate);font-size:16px;line-height:1.8;max-width:720px;margin-bottom:18px}.contact-card{background:var(--cream);border:1px solid #e5e9ee;border-radius:14px;padding:30px;height:max-content}.contact-card h2{font-size:24px;margin-bottom:10px}.contact-card p{color:var(--slate);margin-bottom:20px}.contact-card a{display:block;color:var(--navy);font-weight:700;text-decoration:none;margin:12px 0;overflow-wrap:anywhere}.contact-card .wa{background:#fff;border:1px solid #dfe5ea;padding:12px 14px;border-radius:8px;margin-top:20px}.contact-card small{display:block;color:var(--slate);margin-top:22px;line-height:1.6}.whatsapp-band{background:var(--cream);padding:70px 0}.whatsapp-box{display:flex;align-items:center;justify-content:space-between;gap:50px}.whatsapp-box p:last-child{color:var(--slate);line-height:1.8}.wa-large{flex:none;background:#edf8f1;border:1px solid #cfe9d8;color:#176b38;text-decoration:none;font-weight:700;padding:16px 22px;border-radius:8px}@media(max-width:800px){.page-hero{padding:70px 0;background-position:center}.intro-grid{grid-template-columns:1fr;gap:38px}.block{padding-top:58px;padding-bottom:58px}.whatsapp-box{align-items:flex-start;flex-direction:column;gap:24px}.whatsapp-band{padding:55px 0}}.registration{background:#f4f7f9;padding:76px 0}.reg-head{max-width:760px;margin-bottom:34px}.reg-head h2{font-family:var(--font-display);font-size:clamp(28px,3vw,38px);color:var(--navy-dark);margin:7px 0 10px}.reg-head>p:last-child{color:var(--slate);line-height:1.8}.reg-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.reg-grid article{background:#fff;border:1px solid #e1e8ed;border-radius:14px;padding:28px;box-shadow:0 7px 22px rgba(14,42,70,.04)}.step{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--navy);color:#fff;font-weight:800;margin-bottom:17px}.reg-grid h3{color:var(--navy-dark);font-size:19px;margin-bottom:10px}.reg-grid p,.reg-grid li{color:var(--slate);font-size:14px;line-height:1.75}.reg-grid ul{padding-inline-start:20px}.hours{display:grid;grid-template-columns:auto 1fr;gap:8px 15px;margin-top:18px;padding:15px;border-radius:9px;background:var(--cream);font-size:13px}.hours strong{color:var(--navy-dark)}.note{margin-top:16px;padding-top:14px;border-top:1px solid #e6ebef;font-size:12.5px!important}@media(max-width:850px){.reg-grid{grid-template-columns:1fr}.registration{padding:58px 0}}</style>